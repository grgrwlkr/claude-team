#!/usr/bin/env bash
# orch — the orchestrator's hands: run directory, plan, briefs, spawning, status, brakes.
# bash 3.2 compatible; needs git, jq and claude on PATH. Never launches a session unless told to (spawn without --dry-run).
set -u

SELF="$0"
while [ -L "$SELF" ]; do SELF="$(readlink "$SELF")"; done
PLUGIN_ROOT="$(cd "$(dirname "$SELF")/.." && pwd -P)"
RULES="$PLUGIN_ROOT/skills/orchestrator/references/team-rules.md"
ROLES="analyst developer designer qa reviewer integrator researcher architect design-reviewer qa-lead"
# closure($p; $id): every task $id depends on, directly or through others; safe on cycles.
JQ_DEFS='
def bad(msg): "ERROR: " + msg;
def closure($p; $start):
  {seen: [], todo: [$start]}
  | until((.todo | length) == 0;
      .todo[0] as $x | .todo |= .[1:]
      | if (.seen | index($x)) != null then .
        else .seen += [$x] | .todo += [$p.tasks[] | select(.id == $x) | (.dependsOn // [])[]] end)
  | .seen - [$start];
# paths_meet($a; $b): two pathsAllowed globs may name one file. A literal path meets a glob that starts
# with its literal part; two globs meet when one literal part is a prefix of the other. Conservative on purpose.
def lit: sub("[*?\\[{].*$"; "");
def paths_meet($a; $b):
  ($a | test("[*?\\[{]")) as $wa | ($b | test("[*?\\[{]")) as $wb
  | if ($wa | not) and ($wb | not) then $a == $b
    elif $wb | not then $b | startswith($a | lit)
    elif $wa | not then $a | startswith($b | lit)
    else ($a | lit) as $x | ($b | lit) as $y | ($x | startswith($y)) or ($y | startswith($x)) end;
# as_qa: a plan stored before the tester role merged into qa still holds tester tasks; they run as qa.
def as_qa: if .role == "tester" then .role = "qa" | .qaOf = (.qaOf // .verifies) else . end;
# rebudget($n): a task or session record gets budget $n; the first budget it had stays as budgetInitial,
# so a run can be calibrated afterwards.
def rebudget($n): (if .budget != $n and .budget != null then .budgetInitial = (.budgetInitial // .budget) else . end) | .budget = $n;
'
# Globs as regexes. glob_re: Claude Code's paths — ** any depth, * and ? within one directory, {a,b}
# alternatives; module paths use it because they become path-scoped rules. guard_re: the guard's
# [[ == ]] — * and ? cross directories; pathsAllowed use it.
JQ_GLOB='
def esc_re: gsub("(?<c>[.+^$()|\\[\\]\\\\])"; "\\\(.c)");
def glob_re: "^" + (esc_re
  | gsub("\\*\\*/"; "\u0001") | gsub("\\*\\*"; "\u0002") | gsub("\\*"; "[^/]*") | gsub("\\?"; "[^/]")
  | gsub("\u0001"; "(.*/)?") | gsub("\u0002"; ".*")
  | gsub("\\{(?<in>[^{}]*)\\}"; "(" + (.in | gsub(","; "|")) + ")")) + "$";
def guard_re: "^" + (esc_re | gsub("\\*"; ".*") | gsub("\\?"; ".")) + "$";
def matches_any($globs): . as $f | any($globs[]; . as $g | $f | test($g | glob_re));
def dir_of: if test("/") then sub("/[^/]*$"; "") else "." end;
'
ARCH_MARKER='<!-- Generated by orch architecture --sync from docs/architecture/modules.json. Edit that file and run --sync again; never this one. -->'
# What marks a rule file as generated, whatever the rest of the marker line says.
ARCH_MARK_KEY='Generated by orch architecture --sync'
# Every session the plugin launches, the lead included, runs the built-in Concise output style; --settings outranks /output-style.
STYLE='{"outputStyle":"Concise"}'
# Team sessions start without Remote Control: its mirror of a session carries the session's name, and a
# bare-name SendMessage then fails on "2 agents are named …". The lead keeps it; ORCH_REMOTE_CONTROL=1 keeps it for all.
SPAWN_SETTINGS='{"outputStyle":"Concise","disableRemoteControl":true}'
[ "${ORCH_REMOTE_CONTROL:-}" = 1 ] && SPAWN_SETTINGS="$STYLE"
# Same index the guard keeps (scripts/lib.sh): <session id> -> run dir.
INDEX_DIR="${CLAUDE_ORCH_STATE:-$HOME/.claude/orchestrator-sessions}"
# Where Claude Code keeps user- and local-scope MCP servers, and session transcripts.
CLAUDE_JSON="${ORCH_CLAUDE_JSON:-$HOME/.claude.json}"
PROJECTS_DIR="${ORCH_PROJECTS_DIR:-$HOME/.claude/projects}"

die() { printf 'orch: %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "$1 not found on PATH$2"; }

repo_root() {
  local common
  common=$(git rev-parse --git-common-dir 2>/dev/null) || die "not inside a git repository"
  case "$common" in /*) ;; *) common="$(cd "$common" && pwd -P)";; esac
  dirname "$common"
}
# plain_name <s>: safe as one path component — run and stage names become directories.
plain_name() { case "$1" in ''|.*|-*|*..*|*[!A-Za-z0-9._-]*) return 1 ;; esac; }

# ev <run_dir> <field>...: one event line. Newlines and pipes in a field become spaces, so the text
# of a note can never forge a line the guard counts (allow lines are the budget, nudge lines the reminder).
ev() {
  local d="$1" line f; shift
  line=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  for f in "$@"; do line="$line|$(printf '%s' "$f" | tr '\n|' '  ')"; done
  printf '%s\n' "$line" >> "$d/events.log"
}

# lock_run / unlock_run <run_dir>: the parallel spawns of a wave write sessions.json one at a time.
lock_run() {
  local i=0
  until mkdir "$1/.lock" 2>/dev/null; do
    sleep 0.1; i=$((i + 1))
    [ "$i" -lt 600 ] || die "$1/.lock held for a minute; remove it if no orch command is running"
  done
}
unlock_run() { rmdir "$1/.lock" 2>/dev/null; }

run_dir() {
  plain_name "$1" || die "run name '$1' must be letters, digits, dots, hyphens and underscores, without '..'"
  local r; r="$(repo_root)/.orchestrator/$1"
  [ -d "$r" ] || die "run '$1' does not exist; orch init $1 --base <branch>"
  printf '%s' "$r"
}
# state_root: <repo>/.orchestrator, created and kept out of git status.
state_root() {
  local root excl; root=$(repo_root)
  mkdir -p "$root/.orchestrator"
  excl="$root/.git/info/exclude"
  mkdir -p "$(dirname "$excl")"
  grep -qx '.orchestrator/' "$excl" 2>/dev/null || echo '.orchestrator/' >> "$excl"
  printf '%s' "$root/.orchestrator"
}
strip_ansi() { sed 's/\x1b\[[0-9;]*[A-Za-z]//g'; }
now() { date +%Y-%m-%dT%H:%M:%S%z; }
# shq <s>: s as one word of a shell command line, quoted only when it needs it.
shq() { case "$1" in ''|*[!A-Za-z0-9_./:=@%+,-]*) printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")" ;; *) printf '%s' "$1" ;; esac; }
plugin_version() { jq -r '.version // empty' "$PLUGIN_ROOT/.claude-plugin/plugin.json" 2>/dev/null; }
# version_drift <run_dir>: a line when the run was started on another plugin version than the installed one.
version_drift() {
  local was is; was=$(jq -r '.pluginVersion // empty' "$1/plan.json"); is=$(plugin_version)
  [ -z "$was" ] || [ "$was" = "$is" ] || printf 'run %s was started on plugin %s, installed is %s; sessions spawned now run the new agents and hooks\n' "$(basename "$1")" "$was" "${is:-unknown}"
}

usage() {
  cat <<'EOF'
orch doctor [--no-daemon]                         check claude, jq, git repo, PATH, background service
orch start [--model M] [--fallback M] -- <task>   launch the lead session (default: the latest opus, effort high, no fallback)
orch init <run> --base <branch> [--orchestrator <name>]
orch plan <run> <plan.json> [--replan]            validate and store the task graph; once sessions are registered only with --replan, which carries changed budgets and pathsAllowed into them
orch ready <run>                                  tasks whose dependencies are done and that are not spawned
orch brief <run> <task-id>                        print the brief a spawn would send
orch spawn <run> <task-id> [--round N] [--budget N] [--dry-run]   spawn one task as a background session and register it
orch spawn <run> --wave [--dry-run]               spawn every ready task, up to the plan's maxParallel sessions at work; spawn warns when a task shares paths or resources with a live session of another open run, and when the load average is above the plan's maxLoad per CPU
orch continue <run> <task-id|name> [--budget N] [--dry-run]   the next round of a developer task whose session stopped at its budget, in the same worktree; its brief says to finish from git status
orch status <run> [--no-live]                     roster joined with claude agents --json; TASK: calls of every round of the task, CTX: context size at the session's last turn
orch events <run> [--since <line>|--new] [--blocks]   guard log (blocks, budgets, pauses); --new: the lines since the last --new, --blocks: block lines only
orch runs                                         one line per run in this repo: state, open tasks, sessions claude agents lists, last event
orch graph <run>                                  every task with its state, sessions, calls of all rounds, and why it is not ready
orch inbox <run>                                  what needs the lead: unaccepted done/partial/blocked/failed handoffs, sessions at 80 % of budget, blocks since the last inbox, idle sessions without a handoff, ready tasks
orch handoff <run> <name>                         print a session's latest round's handoff, naming the earlier rounds
orch followups <run>                              every line of the handoffs' "## Follow-ups" sections, with the session that wrote it
orch handoff-put <run> <name> [--file <path>] [--by-lead "<source>"]   write a session's handoff from the file or stdin (works from inside a worktree); --by-lead stamps it as written by the orchestrator from that source
orch qa-request <run> <name> "<what to check>"      a developer asks for qa of its task: adds a qa task after it (paths qa/<task name>/**) and prints the line to send the orchestrator
orch accept <run> <task-id|name> ["<note>"] [--force]   the lead accepts a task, records its branch head, prints what became ready and removes sessions no open task needs. Refused for a task never spawned, cancelled, or whose handoff is none, partial or blocked, and for a branch that changed files outside its pathsAllowed. An architect task is accepted only when orch architecture --check passes in its worktree on a committed map; --force accepts anyway and says why in the note
orch task add <run> <file|->                      add a task (or an array of tasks) through the plan's validation; a developer task with "chore": true is reviewed by the lead: no reviewer or qa task, and accept requires a note
orch task set <run> <task-id|name> <field> <json> change one field of a task; budget and pathsAllowed reach live sessions too
orch task patch <run> <file>                      change fields of several tasks at once, {"<task-id|name>": {"<field>": <json>}}, validated once
orch paths <run> <task-id|name> add <glob>...     widen a task's allowed paths, in the plan and in its live sessions
orch cancel <run> <task-id|name> "<why>"|--undo   drop a task from the run: never ready, settled for close
orch forget <run> <name|--dead>                   drop session records — --dead: those claude agents does not list on this machine — so their tasks can be spawned again
orch grant <run> <task-id|name> <glob>...         the same as orch paths <run> <task> add <glob>...
orch stop <run> <name|all>                        stop the run's sessions (claude stop); worktrees stay
orch rm <run> <name|--settled|all>                remove sessions from claude agents (claude rm) — --settled: those no open task needs; accept and close do it for you
orch cost <run>                                   tokens per session from all its transcripts, subagents included, each message counted once; a lead row when init or address ran in the lead's session
orch address <run> <session-name>                 set the orchestrator's addressable name (from ListAgents)
orch authorize <run> <push-base|delete-merged|tag|install-tools|mutate-data> <on|off>
orch review <run> venue <branch|pr>               where review happens: the branch diff, or a pull/merge request with threads
orch review <run> rounds <n>                      how many review rounds a task may take (default 3)
orch acceptance <run> <on|off>                    require a qa-lead that writes acceptance tests first and accepts the whole change last (default on)
orch approve <run> <stage> "<the user's words>"   staged mode: record the user's approval of a stage; the next one opens
orch approve <run> --rest "<the user's words>"    staged mode: the user lifts staging; one approval covers every stage left
orch stage-report <run> <stage>                   staged mode: an HTML page of the stage's handoffs and evidence, to show the user
orch architecture                                 the architecture map's state in this worktree, the size of the job and the graph tools this stack has
orch architecture --check                         the map against the current tree: coverage by modules.json, dead paths, changes since built-at, generated rules in sync
orch architecture --sync                          write .claude/rules/architecture/<module>.md from docs/architecture/modules.json
orch interactive <run> <on|off>                   require a qa task per developer task, which also runs the app and verifies visually
orch tools [--refresh]                            inventory of the machine's means to run and watch an app; the MCP list is cached for an hour
orch budget <run> <task-id|name> <n|+n>           change a task's budget mid-run (+n adds), in the plan and in the live session's record the guard reads; the first budget stays as budgetInitial
orch pause <run> <name|all> "<reason>"            guard refuses Bash/Edit/Write of that session (or all)
orch resume <run> <name|all>
orch resume-brief <run>                           the run's state from its files: base head, tasks, branches and heads, latest handoffs, sessions, authorizations, last decisions, next commands — run it first after a restart
orch freeze <run> "<why>"                         pause all, write RESUME.md (the resume brief), stop all: the run can go on later or on another machine
orch thaw <run>                                   forget --dead, drop every PAUSE file, print what is ready
orch decide <run> "<decision>" [--for <task>]...  append to decisions.md and log a decide event, one per --for task (else one for the run)
orch lead-branch <run> <branch>                   register a branch the lead made itself, so close checks it is contained in the base
orch close <run> [--force]                        containment report for the run's branches (session worktrees and handoffs), session index cleanup; removes every session of the run and fails while claude agents still lists one; only then writes CLOSED, --force recording the open tasks as cancelled
EOF
}

cmd_doctor() {
  local rc=0 nodaemon=0
  [ "${1:-}" = --no-daemon ] && nodaemon=1
  command -v claude >/dev/null 2>&1 && echo "ok   claude $(claude --version 2>/dev/null | head -1)" || { echo "FAIL claude not on PATH"; rc=1; }
  command -v jq >/dev/null 2>&1 && echo "ok   jq $(jq --version)" || { echo "FAIL jq not on PATH (brew install jq / apt install jq)"; rc=1; }
  git rev-parse --git-dir >/dev/null 2>&1 && echo "ok   git repository: $(repo_root)" || { echo "FAIL not inside a git repository"; rc=1; }
  command -v orch >/dev/null 2>&1 && echo "ok   orch on PATH" || echo "warn orch not on PATH (plugin bin/ is added when the plugin is enabled; fine when calling by path)"
  [ -f "$RULES" ] && echo "ok   rules file $RULES" || { echo "FAIL rules file missing at $RULES"; rc=1; }
  if command -v jq >/dev/null 2>&1 && git rev-parse --git-dir >/dev/null 2>&1; then
    local p m
    for p in "$(repo_root)"/.orchestrator/*/plan.json; do
      [ -f "$p" ] && [ ! -f "${p%plan.json}CLOSED" ] || continue
      m=$(version_drift "$(dirname "$p")"); [ -z "$m" ] || echo "warn $m"
    done
  fi
  if [ "$nodaemon" -eq 0 ]; then
    if claude daemon status >/dev/null 2>&1; then echo "ok   background service running"; else echo "info background service not running; the first claude --bg starts it"; fi
  fi
  return $rc
}

cmd_start() {
  local model=opus fallback=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --model) model="$2"; shift 2 ;;
      --fallback) fallback="$2"; shift 2 ;;
      --) shift; break ;;
      -*) die "unknown option $1" ;;
      *) break ;;
    esac
  done
  [ $# -gt 0 ] || die "start needs a task: orch start -- <task>"
  need claude
  if [ -n "$fallback" ]; then
    exec env -u CLAUDE_CODE_CHILD_SESSION claude --model "$model" --fallback-model "$fallback" --effort high --settings "$STYLE" "/orchestrator $*"
  fi
  exec env -u CLAUDE_CODE_CHILD_SESSION claude --model "$model" --effort high --settings "$STYLE" "/orchestrator $*"
}

cmd_init() {
  local run="${1:-}" base="" orch_name="orchestrator"; shift || true
  [ -n "$run" ] || die "init needs a run name"
  plain_name "$run" || die "run name '$run' must be letters, digits, dots, hyphens and underscores, without '..'"
  while [ $# -gt 0 ]; do
    case "$1" in
      --base) base="$2"; shift 2 ;;
      --orchestrator) orch_name="$2"; shift 2 ;;
      *) die "unknown option $1" ;;
    esac
  done
  [ -n "$base" ] || die "init needs --base <branch>"
  local d; d="$(state_root)/$run"
  [ -e "$d" ] && die "run '$run' already exists at $d"
  local unclosed
  unclosed=$(run_rows "$(live_agents)" | awk -F'\t' '$2 != "closed" { printf "%s%s (%s open tasks, %s live sessions)", (n++ ? ", " : ""), $1, $3, $4 }')
  [ -z "$unclosed" ] || printf 'orch: warning: runs not closed in this repo: %s — close each with orch close <run> once its work is settled (orch runs)\n' "$unclosed" >&2
  mkdir -p "$d/handoffs"
  : > "$d/events.log"
  echo '[]' > "$d/sessions.json"
  printf '# Decisions — run %s\n\n' "$run" > "$d/decisions.md"
  jq -n --arg run "$run" --arg base "$base" --arg o "$orch_name" --arg t "$(now)" --arg pv "$(plugin_version)" \
    '{run:$run, baseBranch:$base, orchestrator:$o, createdAt:$t, pluginVersion:$pv,
      authorize:{pushBase:false, deleteMerged:false, tag:false, installTools:false, mutateData:false},
      review:{venue:"branch", maxRounds:3}, interactive:false, acceptance:true, tasks:[]}' > "$d/plan.json"
  echo '[]' > "$d/accepted.json"
  echo '[]' > "$d/approved.json"
  # The lead runs init and address in its own session; orch cost finds the lead's transcripts by this id.
  [ -z "${CLAUDE_CODE_SESSION_ID:-}" ] || echo "$CLAUDE_CODE_SESSION_ID" > "$d/lead-session"
  echo "$d"
}

cmd_plan() {
  local run="${1:-}" file="${2:-}" replan=0
  [ -n "$run" ] && [ -n "$file" ] || die "plan <run> <plan.json> [--replan]"
  case "${3:-}" in '') ;; --replan) replan=1 ;; *) die "plan <run> <plan.json> [--replan]" ;; esac
  [ -f "$file" ] || die "no such file $file"
  local d; d=$(run_dir "$run")
  jq -e . "$file" >/dev/null 2>&1 || die "$file is not valid JSON"
  local src="$file"
  if jq -e 'any(.tasks[]?; .role == "tester")' "$file" >/dev/null; then
    jq -r '.tasks[] | select(.role == "tester") | "orch: task \(.id): role tester is now qa; rewritten with qaOf \(.qaOf // .verifies // "unset")"' "$file" >&2
    jq "$JQ_DEFS"'.tasks |= map(if .role == "tester" then as_qa | del(.verifies) | if .qaOf == null then del(.qaOf) else . end else . end)' "$file" > "$d/plan.rewritten.json"
    file="$d/plan.rewritten.json"
  fi
  local roles_json; roles_json=$(printf '%s\n' $ROLES | jq -R . | jq -sc .)
  local err
  err=$(jq -r --argjson roles "$roles_json" "$JQ_DEFS"'
    [ .tasks[] | select((.role | IN($roles[])) | not) | bad("task \(.id): unknown role \(.role)") ]
    + [ .tasks[] | select((.id // "") == "" or (.name // "") == "" or (.goal // "") == "") | bad("task \(.id // "?"): id, name and goal are required") ]
    + [ .tasks[] | select(.name | test("^[A-Za-z0-9][A-Za-z0-9-]*$") | not) | bad("task \(.id): name must be letters, digits, hyphens") ]
    + ( [ .tasks[].name ] | group_by(.) | map(select(length > 1) | bad("duplicate name \(.[0])")) )
    + ( [ .tasks[].id ] | group_by(.) | map(select(length > 1) | bad("duplicate id \(.[0])")) )
    + ( . as $p | [ .tasks[] | .dependsOn[]? as $dep | select(($p.tasks | map(.id) | index($dep)) == null) | bad("task \(.id): dependsOn unknown task \($dep)") ] )
    + ( [ .tasks[] | select((.role | IN("reviewer", "qa", "design-reviewer") | not) and ((.pathsAllowed // []) | length) == 0) | bad("task \(.id): pathsAllowed is empty; only the reviewer, qa and the design-reviewer may own no paths") ] )
    + ( . as $p
        | [ $p.tasks[] | select(.role == "developer" and .chore != true) as $t
            | select(([ $p.tasks[] | select(.role == "reviewer")
                        | select(((.reviewOf // "") == $t.id) or (((.dependsOn // []) | index($t.id)) != null)) ] | length) == 0)
            | bad("task \($t.id) writes code and no reviewer task reviews it; add a reviewer task with reviewOf: \"\($t.id)\"") ] )
    + [ .tasks[] | select(has("chore") and .role != "developer") | bad("task \(.id): chore belongs on a developer task, which the lead reviews itself; a \(.role) task is not one") ]
    + [ .tasks[] | select(has("resources") and ((.resources | type) != "array" or any(.resources[]; type != "string" or (test("^[a-z]+:.") | not))))
        | bad("task \(.id): resources must be a list like [\"port:8000\", \"compose:<project>\"]: what the task holds that no task running beside it may use") ]
    + (if has("setup") and ((.setup | type) != "array" or any(.setup[]; type != "string")) then [bad("setup must be a list of shell commands, run in each new worktree before its session starts")] else [] end)
    + (if has("maxParallel") and ((.maxParallel | type) != "number" or .maxParallel < 1 or .maxParallel != (.maxParallel | floor)) then [bad("maxParallel must be a whole number, 1 or more: how many sessions of the run orch spawn --wave lets work at once")] else [] end)
    + (if has("maxLoad") and ((.maxLoad | type) != "number" or .maxLoad <= 0) then [bad("maxLoad must be a number above 0: the load average per CPU above which orch spawn warns")] else [] end)
    # Two tasks can be live together unless one is in the dependency closure of the other, they sit in
    # different stages of a staged run, or one is the architect design task, which every other task waits for.
    # The integrator owns ** to resolve conflicts in the branches it merges, not to write work of its own.
    # Resources (a port, a compose project) are held the way paths are.
    + ( . as $p
        | [ .tasks[] | select((.role == "architect" and .phase == "design") or .role == "integrator" | not)
            | {id, stage: (.stage // ""), c: closure($p; .id), paths: (.pathsAllowed // []), res: [.resources[]?]} ] as $t
        | [ range(0; $t|length) as $i | range($i+1; $t|length) as $j
            | select(($t[$i].c | index($t[$j].id)) == null and ($t[$j].c | index($t[$i].id)) == null)
            | select(($p.mode // "single") != "staged" or $t[$i].stage == $t[$j].stage)
            | [ $t[$i].paths[] as $x | $t[$j].paths[] as $y | select(paths_meet($x; $y)) | if $x == $y then $x else "\($x) ~ \($y)" end ] as $shared
            | [ $t[$i].res[] as $x | select(any($t[$j].res[]; . == $x)) | $x ] as $held
            | select(($shared + $held | length) > 0)
            | bad("tasks \($t[$i].id) and \($t[$j].id) share \([ (if ($shared | length) > 0 then "paths \($shared | join(", "))" else empty end), (if ($held | length) > 0 then "resources \($held | join(", "))" else empty end) ] | join(" and ")) and can run at the same time; sequence them or split the paths") ] )
    + ( . as $p
        | [ $p.tasks[] | select(.role == "developer") as $t
            | $p.tasks[] | select(.role == "qa" or (.role == "qa-lead" and .phase == "author")) as $q
            | [ ($t.pathsAllowed // [])[] as $x | ($q.pathsAllowed // [])[] as $y | select(paths_meet($x; $y)) | if $x == $y then $x else "\($x) ~ \($y)" end ] as $shared
            | select(($shared | length) > 0)
            | bad("developer task \($t.id) may write the paths of \($q.role) task \($q.id) (\($shared | join(", "))): tests a developer must never edit; narrow its pathsAllowed") ] )
    + ( . as $p
        | [ {f: "reviewOf", r: "reviewer"}, {f: "qaOf", r: "qa"}, {f: "designOf", r: "design-reviewer"}
            | . as $k | $p.tasks[] | select(has($k.f)) as $t
            | (if $t.role != $k.r then bad("task \($t.id): \($k.f) belongs on a \($k.r) task, not on a \($t.role)") else empty end),
              (if any($p.tasks[]; .id == $t[$k.f] and .role == "developer") then empty else bad("task \($t.id): \($k.f) \($t[$k.f]) names no developer task of this plan") end) ] )
    + ( . as $p
        | [ $p.tasks[] | select(.role == "designer") | .id ] as $des
        | if ($des | length) == 0 then [] else
            [ $p.tasks[] | select(.role == "developer") as $t
              | select(closure($p; $t.id) as $c | ($c - ($c - $des)) | length > 0)
              | select(([ $p.tasks[] | select(.role == "design-reviewer" and (.designOf // "") == $t.id) ] | length) == 0)
              | bad("task \($t.id) implements a designer task and no design-reviewer checks it; add a design-reviewer task with designOf: \"\($t.id)\"") ]
          end )
    + [ .tasks[] | select(.role == "qa-lead" and ((.phase // "") | IN("author", "accept") | not)) | bad("task \(.id): a qa-lead task needs phase author or accept") ]
    + [ .tasks[] | select(.role == "architect" and ((.phase // "") | IN("design", "update") | not)) | bad("task \(.id): an architect task needs phase design or update") ]
    + ( . as $p
        | [ $p.tasks[] | select(.role == "architect" and .phase == "design") ] as $ad
        | (if ([ $p.tasks[] | select(.role == "developer") ] | length) > 0 and ($ad | length) == 0
           then [bad("the plan has developer tasks and no architect task with phase design; every run that changes code starts with the architect checking the map against the code and bringing it up to date (orch architecture shows its state)")] else [] end)
          + [ $ad[] | select((.dependsOn // []) | length > 0) | bad("architect task \(.id) (phase design) must depend on nothing: it runs first, and every other task waits until the lead accepts its checked map") ]
          + (if ($p.mode // "single") == "staged"
             then [ $ad[] | select((.stage // "") != (($p.stages // [])[0] // "")) | bad("architect task \(.id) (phase design) belongs to the first stage, \(($p.stages // [])[0] // "?"): every other task waits for it") ]
             else [] end) )
    + ( if (.mode // "single") == "staged" then
          (.stages // []) as $s
          | (if ($s | length) == 0 then [bad("mode staged needs a stages list, in order")] else [] end)
            + [ $s[] | select(if type != "string" then true else ((test("^[A-Za-z0-9][A-Za-z0-9._-]*$") | not) or test("[.][.]")) end)
                | bad("stage name \(.) must be letters, digits, dots, hyphens and underscores, without ..") ]
            + [ .tasks[] | select((.stage // "") as $g | ($s | index($g)) == null) | bad("task \(.id): stage \(.stage // "missing") is not one of \($s | join(", "))") ]
            + ( . as $p | [ $p.tasks[] as $t | ($t.dependsOn // [])[] as $dep | ($p.tasks[] | select(.id == $dep)) as $x
                | select(($s | index($x.stage // "")) != null and ($s | index($t.stage // "")) != null)
                | select(($s | index($x.stage)) > ($s | index($t.stage)))
                | bad("task \($t.id) of stage \($t.stage) depends on \($x.id) of the later stage \($x.stage)") ] )
        elif (.mode // "single") != "single" then [bad("mode must be single or staged")]
        else [] end )
    | .[]' "$file")
  if [ -n "$err" ]; then printf '%s\n' "$err" >&2; exit 1; fi
  local base orch_name created auth review interactive acceptance pv
  base=$(jq -r '.baseBranch' "$d/plan.json"); orch_name=$(jq -r '.orchestrator' "$d/plan.json"); created=$(jq -r '.createdAt' "$d/plan.json")
  pv=$(jq -c '.pluginVersion // null' "$d/plan.json")
  auth=$(jq -c '.authorize // {pushBase:false, deleteMerged:false, tag:false, installTools:false}' "$d/plan.json")
  review=$(jq -c '.review // {venue:"branch", maxRounds:3}' "$d/plan.json")
  interactive=$(jq -r '.interactive // false' "$d/plan.json")
  if [ "$interactive" = true ]; then
    err=$(jq -r '
      def bad(msg): "ERROR: " + msg;
      . as $p
      | [ $p.tasks[] | select(.role == "developer" and .chore != true) as $t
          | select(([ $p.tasks[] | select(.role == "qa" and (.qaOf // "") == $t.id) ] | length) == 0)
          | bad("interactive verification is on and task \($t.id) has no qa task; add a qa task with qaOf: \"\($t.id)\" that also runs the app and checks the criteria") ]
      | .[]' "$file")
    if [ -n "$err" ]; then printf '%s\n' "$err" >&2; exit 1; fi
  fi
  acceptance=$(jq -r 'if .acceptance == false then "false" else "true" end' "$d/plan.json")
  if [ "$acceptance" = true ]; then
    err=$(jq -r "$JQ_DEFS"'
      . as $p
      | [ $p.tasks[] | select(.role == "developer") | .id ] as $devs
      | if ($devs | length) == 0 then [] else
          (if ([ $p.tasks[] | select(.role == "qa-lead" and .phase == "author") ] | length) == 0
           then [bad("acceptance testing is on and no qa-lead task with phase author writes the acceptance tests; add one after the spec, or orch acceptance <run> off")] else [] end)
          + (if ([ $p.tasks[] | select(.role == "qa-lead" and .phase == "accept") ] | length) == 0
             then [bad("acceptance testing is on and no qa-lead task with phase accept accepts the whole change; add one after every developer task, or orch acceptance <run> off")] else [] end)
          + [ $p.tasks[] | select(.role == "qa-lead" and .phase == "accept") as $a
              | closure($p; $a.id) as $c | ($devs - $c)[] as $miss
              | bad("qa-lead task \($a.id) accepts the whole change but does not come after developer task \($miss); make it depend on every developer task, directly or through the integrator") ]
        end
      | .[]' "$file")
    if [ -n "$err" ]; then printf '%s\n' "$err" >&2; exit 1; fi
  fi
  jq -r --arg f "$src" --argjson s "{\"authorize\":$auth,\"review\":$review,\"interactive\":$interactive,\"acceptance\":$acceptance}" \
    '. as $p | $s | keys[] | select(. as $k | $p | has($k) and .[$k] != $s[$k])
     | "orch: warning: \(.) in \($f) differs from the stored value; orch plan keeps the stored one — set it with orch \(.) <run> …"' "$file" >&2
  # task add and task set come through here with --replan; their copy of the plan changes one task at a time.
  if [ "$replan" = 0 ] && jq -e 'length > 0' "$d/sessions.json" >/dev/null 2>&1; then
    die "run $run has registered sessions and orch plan would change tasks under them: use orch task set, orch paths or orch budget, or orch plan $run $file --replan, which also carries each changed budget and pathsAllowed into the sessions of that task"
  fi
  local archb=0 r sha
  if jq -e 'any(.tasks[]; .role == "architect" and .budget == null)' "$file" >/dev/null; then
    r=$(arch_root); sha=$(arch_sha)
    # The heuristic orch architecture prints: updating a map when there is one, building it otherwise.
    if [ -n "$sha" ]; then archb=$((15 + $(git -C "$r" diff --name-only "$sha" HEAD | wc -l) / 5)); else archb=$((40 + $(git -C "$r" ls-files | wc -l) / 20)); fi
  fi
  local old; old=$(cat "$d/plan.json")
  jq --arg run "$run" --arg base "$base" --arg o "$orch_name" --arg t "$created" --argjson auth "$auth" --argjson review "$review" --argjson inter "$interactive" --argjson acc "$acceptance" --argjson archb "$archb" --argjson pv "$pv" \
     '{developer: 120, reviewer: 30, "design-reviewer": 25, qa: 60, integrator: 50, analyst: 50, researcher: 70, designer: 70} as $budgets
      | .run = $run | .baseBranch = (.baseBranch // $base) | .orchestrator = $o | .createdAt = $t | .authorize = $auth | .review = $review | .interactive = $inter | .acceptance = $acc
      | (if $pv == null then del(.pluginVersion) else .pluginVersion = $pv end)
      | .tasks |= map(.budget = (.budget // (if .role == "qa-lead" then (if .phase == "accept" then 40 else 80 end) elif .role == "architect" then $archb else ($budgets[.role] // 150) end)) | .model = (.model // "opus") | .effort = (.effort // "high") | .dependsOn = (.dependsOn // []) | .pathsAllowed = (.pathsAllowed // []) | .acceptance = (.acceptance // [])
          | if .role == "architect" then .pathsAllowed += (["docs/architecture/**", ".claude/rules/architecture/**"] - .pathsAllowed) else . end)' \
     "$file" > "$d/plan.json.tmp" && mv "$d/plan.json.tmp" "$d/plan.json"
  rm -f "$d/plan.rewritten.json"
  if [ "$replan" = 1 ]; then
    # A replan file written by hand need not repeat budgetInitial; the stored one stays.
    jq --argjson old "$old" "$JQ_DEFS"'($old.tasks | map({key: .id, value: .}) | from_entries) as $o
      | .tasks |= map(($o[.id] // null) as $was
          | if $was == null then . else .budget as $b | .budget = $was.budget | .budgetInitial = (.budgetInitial // $was.budgetInitial) | rebudget($b) end
          | if .budgetInitial == null then del(.budgetInitial) else . end)' "$d/plan.json" > "$d/plan.json.tmp" && mv "$d/plan.json.tmp" "$d/plan.json"
    lock_run "$d"
    jq --argjson old "$old" --slurpfile new "$d/plan.json" "$JQ_DEFS"'
      ($old.tasks | map({key: .id, value: .}) | from_entries) as $o
      | ($new[0].tasks | map({key: .id, value: .}) | from_entries) as $n
      | map(. as $s | ($n[$s.taskId] // null) as $t | ($o[$s.taskId] // {}) as $was
          | if $t == null then .
            else (if $t.budget != $was.budget then rebudget($t.budget) else . end)
               | (if $t.pathsAllowed != $was.pathsAllowed then .pathsAllowed = $t.pathsAllowed else . end) end)' \
      "$d/sessions.json" > "$d/sessions.json.tmp" && mv "$d/sessions.json.tmp" "$d/sessions.json"
    unlock_run "$d"
  fi
  cross_run_overlap "$d" "$(jq -c --slurpfile s "$d/sessions.json" '[.tasks[] | select(.id as $id | $s[0] | map(.taskId) | index($id) | not)]' "$d/plan.json")"
  echo "plan stored: $(jq '.tasks | length' "$d/plan.json") tasks → $d/plan.json"
}

# handoff_word <file>: the first word of the first non-empty line under "## Status", lowercased.
# The word, not a substring: "blocked — waiting until dev-1 is done" is blocked.
handoff_word() {
  awk '/^## Status/ {f=1; next} f && NF {print tolower($1); exit}' "$1" | tr -cd 'a-z'
}

# latest_handoff <run_dir> <name>: the path of the latest round's handoff — <name>-r<N>.md with the
# highest N present, else <name>.md, whether or not that exists. A later round supersedes the first.
latest_handoff() {
  local f n best=1 path="$1/handoffs/$2.md"
  for f in "$1/handoffs/$2"-r*.md; do
    n=${f#"$1/handoffs/$2"-r}; n=${n%.md}
    case "$n" in ''|*[!0-9]*) continue ;; esac
    [ "$n" -gt "$best" ] && { best=$n; path=$f; }
  done
  printf '%s' "$path"
}

# target_ref <run_dir> <task name>: where a task's work is — its worktree, branch and current head.
target_ref() {
  local wt sha
  wt=$(task_worktree "$1" "$2")
  sha=$(git -C "$(repo_root)" rev-parse -q --verify "refs/heads/$(basename "$wt")^{commit}" 2>/dev/null) || sha="none yet (made when $2 is spawned)"
  printf 'worktree %s, branch %s, head %s' "$wt" "$(basename "$wt")" "$sha"
}

# resolve_task <run_dir> <task-id|task name|session name>: the task id. A review round's session
# name (<task name>-r<N>) resolves to its task. Fails when nothing matches.
resolve_task() {
  local d="$1" w="$2" id
  id=$(jq -r --arg w "$w" 'first(.tasks[] | select(.id == $w or .name == $w) | .id) // empty' "$d/plan.json")
  [ -n "$id" ] || id=$(jq -r --arg w "$w" 'first(.[] | select(.name == $w) | .taskId) // empty' "$d/sessions.json")
  if [ -z "$id" ]; then
    case "$w" in *-r[0-9]*) id=$(jq -r --arg w "${w%-r*}" 'first(.tasks[] | select(.name == $w) | .id) // empty' "$d/plan.json") ;; esac
  fi
  [ -n "$id" ] && printf '%s' "$id"
}

# stage_gate <run_dir> <stage>: in staged mode, the first earlier stage the user has not approved yet.
stage_gate() {
  [ "$(jq -r '.mode // "single"' "$1/plan.json")" = staged ] || return 0
  [ -f "$1/approved.json" ] || echo '[]' > "$1/approved.json"
  jq -r --arg s "$2" --slurpfile ap "$1/approved.json" '(.stages // []) as $all | ($all | index($s)) as $i
    | if $i == null then empty else [ $all[:$i][] | select(. as $x | ($ap[0] | map(.stage) | index($x)) == null) ] | first // empty end' "$1/plan.json"
}

# open_tasks <run_dir> [stage]: tasks neither accepted nor cancelled. A reviewer, qa or
# design-reviewer task is settled with the task it covers: the lead accepts code, not reviews.
open_tasks() {
  [ -f "$1/cancelled.json" ] || echo '[]' > "$1/cancelled.json"
  [ -f "$1/accepted.json" ] || echo '[]' > "$1/accepted.json"
  jq -r --arg st "${2:-}" --slurpfile acc "$1/accepted.json" --slurpfile can "$1/cancelled.json" '
    ($acc[0] + $can[0] | map(.taskId)) as $ok
    | .tasks[]
    | select($st == "" or (.stage // "") == $st)
    | .id as $id
    | select(($ok | index($id)) == null)
    | select(((.reviewOf // .verifies // .qaOf // .designOf // "") as $t | $t != "" and ($ok | index($t)) != null) | not)
    | .id' "$1/plan.json"
}

is_accepted() {
  [ -f "$1/accepted.json" ] && jq -e --arg id "$2" 'map(select(.taskId == $id)) | length > 0' "$1/accepted.json" >/dev/null 2>&1
}

# arch_gate <run_dir> <role>: the architect's design task this role still waits for. Every other task
# starts from a map the lead accepted, and orch accept runs the check before it records that.
arch_gate() {
  [ "$2" = architect ] && return 0
  [ -f "$1/accepted.json" ] || echo '[]' > "$1/accepted.json"
  jq -r --slurpfile acc "$1/accepted.json" '($acc[0] | map(.taskId)) as $ok
    | first(.tasks[] | select(.role == "architect" and .phase == "design") | .id | select(. as $id | $ok | index($id) == null)) // empty' "$1/plan.json"
}

is_cancelled() {
  [ -f "$1/cancelled.json" ] && jq -e --arg id "$2" 'map(select(.taskId == $id)) | length > 0' "$1/cancelled.json" >/dev/null 2>&1
}

# task_done <run_dir> <task-id> [<dependent's role>]: the lead accepted the task, or its handoff says done.
# Acceptance is separate from the handoff on purpose: a task can be finished while its
# handoff reads "blocked" on something the lead resolved (a push the user later authorized).
# A developer's own "done" opens the door only to the roles that verify it; whatever builds
# on the code (the integrator, the next developer) waits for orch accept.
task_done() {
  local name role
  name=$(jq -r --arg id "$2" '.tasks[] | select(.id == $id) | .name' "$1/plan.json")
  role=$(jq -r --arg id "$2" '.tasks[] | select(.id == $id) | .role' "$1/plan.json")
  [ -n "$name" ] || return 1
  if [ -f "$1/accepted.json" ] && jq -e --arg id "$2" 'map(select(.taskId == $id)) | length > 0' "$1/accepted.json" >/dev/null 2>&1; then
    return 0
  fi
  if [ "$role" = developer ]; then
    case "${3:-}" in reviewer|qa|design-reviewer) ;; *) return 1 ;; esac
  fi
  local h; h=$(latest_handoff "$1" "$name")
  [ -f "$h" ] && [ "$(handoff_word "$h")" = "done" ]
}

# handoff_state <run_dir> <name> <task-id>: accepted | settled | done | partial | blocked | failed | none.
# settled: the task a review, qa or design review covers is accepted, as open_tasks counts it.
handoff_state() {
  if is_cancelled "$1" "$3"; then printf 'cancelled'; return; fi
  if [ -f "$1/accepted.json" ] && jq -e --arg id "$3" 'map(select(.taskId == $id)) | length > 0' "$1/accepted.json" >/dev/null 2>&1; then
    printf 'accepted'; return
  fi
  local cov; cov=$(jq -r --arg id "$3" 'first(.tasks[] | select(.id == $id) | .reviewOf // .verifies // .qaOf // .designOf) // empty' "$1/plan.json")
  if [ -n "$cov" ] && is_accepted "$1" "$cov"; then printf 'settled'; return; fi
  local h word; h=$(latest_handoff "$1" "$2")
  [ -f "$h" ] || { printf 'none'; return; }
  word=$(handoff_word "$h")
  case "$word" in
    done|partial|blocked|failed) printf '%s' "$word" ;;
    *) printf 'written' ;;
  esac
}

cmd_ready() {
  local d; d=$(run_dir "${1:-}")
  local id ok dep spawned role
  for id in $(jq -r '.tasks[].id' "$d/plan.json"); do
    spawned=$(jq -r --arg id "$id" 'map(select(.taskId == $id)) | length' "$d/sessions.json")
    [ "$spawned" -eq 0 ] || continue
    is_cancelled "$d" "$id" && continue
    is_accepted "$d" "$id" && continue
    [ -n "$(stage_gate "$d" "$(jq -r --arg id "$id" '.tasks[] | select(.id == $id) | .stage // ""' "$d/plan.json")")" ] && continue
    role=$(jq -r --arg id "$id" '.tasks[] | select(.id == $id) | .role' "$d/plan.json")
    [ -n "$(arch_gate "$d" "$role")" ] && continue
    ok=1
    for dep in $(jq -r --arg id "$id" '.tasks[] | select(.id == $id) | .dependsOn[]' "$d/plan.json"); do
      task_done "$d" "$dep" "$role" || { ok=0; break; }
    done
    [ "$ok" -eq 1 ] && echo "$id"
  done
  return 0
}

cmd_accept() {
  local d; d=$(run_dir "${1:-}"); local id="${2:-}" note="" force=0 a
  for a in "${@:3}"; do if [ "$a" = --force ]; then force=1; else note="$a"; fi; done
  [ -n "$id" ] || die "accept <run> <task-id|name> [\"<note>\"] [--force]"
  id=$(resolve_task "$d" "$id") || die "no task or session '${2:-}' in plan"
  # No reviewer read a chore's diff, so the note is the only record that anyone did; --force does not replace it.
  if [ "$(jq -r --arg id "$id" '.tasks[] | select(.id == $id) | .chore // false' "$d/plan.json")" = true ] && [ -z "$note" ]; then
    die "not accepting $id: it is a chore task, reviewed by you alone; accept it with a note naming the diff you read, e.g. orch accept ${1:-} $id \"read <base>...<branch>: <what it changes>\""
  fi
  # An architect's map is accepted only as the check finds it, committed on the architect's branch.
  if [ "$(jq -r --arg id "$id" '.tasks[] | select(.id == $id) | .role' "$d/plan.json")" = architect ]; then
    if [ "$force" -eq 1 ]; then
      note="$note (map check skipped: --force)"
    else
      local wt out dirty
      wt=$(task_worktree "$d" "$(jq -r --arg id "$id" '.tasks[] | select(.id == $id) | .name' "$d/plan.json")")
      [ -d "$wt" ] || die "no worktree $wt: the architect has not run, so there is no map to check. orch accept … --force records the acceptance with the check skipped"
      out=$(cd "$wt" && arch_check) || die "the map in $wt fails the check, so the run would start from it wrong:
$out
Send the architect these lines; orch accept … --force records the acceptance anyway, with the check skipped"
      dirty=$(git -C "$wt" status --porcelain -- docs/architecture .claude/rules/architecture)
      [ -z "$dirty" ] || die "the map in $wt passes the check but is not committed on $(basename "$wt"), so it would never reach the integrator:
$dirty"
      note="$note (map check passed)"
    fi
  fi
  local task name why="" hs root wt branch head outside before after t fresh=""
  task=$(jq -c --arg id "$id" '.tasks[] | select(.id == $id)' "$d/plan.json"); name=$(jq -r '.name' <<<"$task")
  hs=$(handoff_state "$d" "$name" "$id")
  if is_cancelled "$d" "$id"; then
    why="it is cancelled"
  # A forgotten session was spawned all the same.
  elif ! cat "$d/sessions.json" "$d/forgotten.json" 2>/dev/null | jq -s -e --arg id "$id" 'add | map(select(.taskId == $id)) | length > 0' >/dev/null; then
    why="it was never spawned"
  else
    case "$hs" in none|partial|blocked) why="its handoff is $hs" ;; esac
  fi
  if [ -n "$why" ]; then
    [ "$force" -eq 1 ] || die "not accepting $id: $why. Read its handoff and its branch; orch accept … --force records the acceptance anyway, with the reason in the note"
    note="$note (forced: $why)"
  fi
  root=$(repo_root); wt=$(task_worktree "$d" "$name"); branch=$(basename "$wt")
  head=$(git -C "$root" rev-parse -q --verify "refs/heads/$branch^{commit}" 2>/dev/null) || head=""
  # The guard cannot resolve every Bash write, so the branch itself is checked against the task's paths.
  if [ -n "$head" ] && [ "$(jq '.pathsAllowed | length' <<<"$task")" -gt 0 ]; then
    outside=$( { git -C "$root" diff --no-renames --name-only "$(jq -r '.baseBranch' "$d/plan.json")...$branch"
                 [ ! -d "$wt" ] || { git -C "$wt" diff --no-renames --name-only HEAD; git -C "$wt" ls-files --others --exclude-standard; }; } \
      | sort -u | jq -R . | jq -rs --argjson g "$(jq -c '.pathsAllowed' <<<"$task")" "$JQ_GLOB"'
        .[] | select(. != "" and (startswith(".scratch/") | not) and (. as $f | any($g[]; . as $x | $f | test($x | guard_re)) | not))')
    if [ -n "$outside" ]; then
      [ "$force" -eq 1 ] || die "not accepting $id: $branch changed files outside its paths ($(jq -r '.pathsAllowed | join(", ")' <<<"$task")):
$outside
Have them reverted or moved to a task that owns them, or grant the paths (orch paths); orch accept … --force records the acceptance anyway, with the files in the note"
      note="$note (outside pathsAllowed: $(printf '%s' "$outside" | tr '\n' ' '))"
    fi
  fi
  before=$(cmd_ready "$1")
  [ -f "$d/accepted.json" ] || echo '[]' > "$d/accepted.json"
  jq --arg id "$id" --arg note "$note" --arg t "$(now)" --arg head "$head" \
     'map(select(.taskId != $id)) + [{taskId:$id, at:$t, note:$note, head:$head}]' "$d/accepted.json" > "$d/accepted.tmp" && mv "$d/accepted.tmp" "$d/accepted.json"
  ev "$d" orchestrator "$id" accept allow "$note"
  after=$(cmd_ready "$1")
  for t in $after; do printf '%s\n' "$before" | grep -qxF "$t" || fresh="$fresh $t"; done
  echo "accepted $id${head:+ at $head}${fresh:+ — now ready:$fresh}"
  backfill_session_ids "$d"
  # An acceptance can finish sessions of other tasks too: a developer's, once the integrator building on it is accepted.
  local done_names; done_names=$(finished_sessions "$d") || true
  # shellcheck disable=SC2086  # one session name per word
  [ -z "$done_names" ] || ! command -v claude >/dev/null 2>&1 || remove_sessions "$d" "$d/sessions.json" $done_names || true
}

cmd_address() {
  local d; d=$(run_dir "${1:-}"); local name="${2:-}"
  [ -n "$name" ] || die "address <run> <session-name>  (your own name, the first row of ListAgents)"
  jq --arg o "$name" '.orchestrator = $o' "$d/plan.json" > "$d/plan.tmp" && mv "$d/plan.tmp" "$d/plan.json"
  [ -z "${CLAUDE_CODE_SESSION_ID:-}" ] || echo "$CLAUDE_CODE_SESSION_ID" > "$d/lead-session"
  echo "orchestrator address: $name — teammates spawned from now on address you by it"
}

cmd_authorize() {
  local d; d=$(run_dir "${1:-}"); local flag="${2:-}" value="${3:-on}" key
  case "$flag" in
    push-base) key=pushBase ;;
    delete-merged) key=deleteMerged ;;
    tag) key=tag ;;
    install-tools) key=installTools ;;
    mutate-data) key=mutateData ;;
    *) die "authorize <run> <push-base|delete-merged|tag|install-tools|mutate-data> <on|off>" ;;
  esac
  case "$value" in on|true|yes) value=true ;; off|false|no) value=false ;; *) die "value must be on or off" ;; esac
  jq --arg k "$key" --argjson v "$value" '.authorize = ((.authorize // {}) | .[$k] = $v)' "$d/plan.json" > "$d/plan.tmp" && mv "$d/plan.tmp" "$d/plan.json"
  ev "$d" orchestrator "$flag" authorize allow "$value"
  echo "authorize $flag=$value — the guard honours it for this run"
}

cmd_review() {
  local d; d=$(run_dir "${1:-}"); local key="${2:-}" value="${3:-}"
  case "$key" in
    venue)
      case "$value" in
        branch|pr) ;;
        *) die "review <run> venue <branch|pr>  (branch: the reviewer reads the diff; pr: everyone who changed code opens a pull or merge request and reviewers comment in threads)" ;;
      esac
      jq --arg v "$value" '.review = ((.review // {maxRounds:3}) | .venue = $v)' "$d/plan.json" > "$d/plan.tmp" && mv "$d/plan.tmp" "$d/plan.json"
      echo "review venue: $value"
      ;;
    rounds)
      case "$value" in ''|*[!0-9]*) die "review <run> rounds <n>" ;; esac
      [ "$value" -ge 1 ] || die "rounds must be at least 1"
      jq --argjson n "$value" '.review = ((.review // {venue:"branch"}) | .maxRounds = $n)' "$d/plan.json" > "$d/plan.tmp" && mv "$d/plan.tmp" "$d/plan.json"
      echo "review rounds: up to $value"
      ;;
    *) die "review <run> <venue|rounds> <value>" ;;
  esac
}

cmd_acceptance() {
  local d; d=$(run_dir "${1:-}"); local value="${2:-}"
  case "$value" in on|true|yes) value=true ;; off|false|no) value=false ;; *) die "acceptance <run> <on|off>" ;; esac
  jq --argjson v "$value" '.acceptance = $v' "$d/plan.json" > "$d/plan.tmp" && mv "$d/plan.tmp" "$d/plan.json"
  if [ "$value" = true ]; then
    echo "acceptance testing on: the plan needs a qa-lead author task after the spec and an accept task after every developer task"
  else
    echo "acceptance testing off"
  fi
}

cmd_interactive() {
  local d; d=$(run_dir "${1:-}"); local value="${2:-}"
  case "$value" in on|true|yes) value=true ;; off|false|no) value=false ;; *) die "interactive <run> <on|off>" ;; esac
  jq --argjson v "$value" '.interactive = $v' "$d/plan.json" > "$d/plan.tmp" && mv "$d/plan.tmp" "$d/plan.json"
  if [ "$value" = true ]; then
    echo "interactive verification on: every developer task needs a qa task (qaOf: <id>), which also runs the app; orch plan enforces it"
  else
    echo "interactive verification off"
  fi
}

# tool_row <group> <name> <probe-command> <install hint>
tool_row() {
  local status="missing" hint="$4"
  if eval "$3" >/dev/null 2>&1; then status="available"; hint=""
  else
    # An MCP list that timed out proves nothing: a configured server must not read as missing.
    case "$3" in has_mcp*) if has_mcp "$MCP_TIMED_OUT"; then status="unknown"; hint="claude mcp list timed out; check /mcp in a session"; fi ;; esac
  fi
  printf '%-11s %-24s %-10s %s\n' "$1" "$2" "$status" "$hint"
}

MCP_TIMED_OUT="orch: mcp list timed out"
# mcp_list <refresh:0|1>: `claude mcp list` health-checks every configured server, so it is bounded
# (ORCH_MCP_TIMEOUT seconds, default 45) and cached for an hour under <repo>/.orchestrator/.
mcp_list() {
  command -v claude >/dev/null 2>&1 || return 0
  local cache="" tmp pid i=0 limit="${ORCH_MCP_TIMEOUT:-45}"
  git rev-parse --git-dir >/dev/null 2>&1 && cache="$(state_root)/tools-mcp.cache"
  if [ -n "$cache" ] && [ "$1" -eq 0 ] && [ -n "$(find "$cache" -mmin -60 2>/dev/null)" ]; then
    cat "$cache"; return 0
  fi
  tmp=$(mktemp "${TMPDIR:-/tmp}/orch-mcp.XXXXXX") || return 0
  claude mcp list >"$tmp" 2>/dev/null & pid=$!
  while kill -0 "$pid" 2>/dev/null && [ "$i" -lt $((limit * 5)) ]; do sleep 0.2; i=$((i+1)); done
  if kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null
    echo "note: claude mcp list did not finish in $limit s; MCP rows below may read missing (ORCH_MCP_TIMEOUT raises the limit)" >&2
    strip_ansi < "$tmp"
    echo "$MCP_TIMED_OUT"
  else
    strip_ansi < "$tmp" | if [ -n "$cache" ]; then tee "$cache"; else cat; fi
  fi
  rm -f "$tmp"
}

cmd_tools() {
  local mcps="" refresh=0
  [ "${1:-}" = --refresh ] && refresh=1
  mcps=$(mcp_list "$refresh")
  has_mcp() { printf '%s' "$mcps" | grep -qi -- "$1"; }
  echo "Means of running and watching an app on this machine (for the qa role; the lead asks the user before anything is installed):"
  printf '%-11s %-24s %-10s %s\n' GROUP TOOL STATUS "INSTALL HINT"
  tool_row browser "claude-in-chrome MCP" 'has_mcp claude-in-chrome' "Claude in Chrome extension + /chrome in a session"
  tool_row browser "chrome-devtools MCP" 'has_mcp chrome-devtools' "claude mcp add chrome-devtools -- npx -y chrome-devtools-mcp@latest"
  tool_row browser "playwright MCP" 'has_mcp playwright' "claude mcp add playwright -- npx -y @playwright/mcp@latest"
  tool_row browser "playwright CLI" 'command -v playwright || ls node_modules/.bin/playwright' "npm i -D @playwright/test && npx playwright install chromium"
  tool_row browser "puppeteer" 'ls node_modules/puppeteer' "npm i -D puppeteer"
  tool_row screenshot "screencapture (macOS)" 'command -v screencapture' "part of macOS"
  tool_row screenshot "peekaboo MCP (macOS)" 'has_mcp peekaboo' "brew install steipete/tap/peekaboo"
  tool_row screenshot "computer-use MCP" 'has_mcp computer-use' "Claude Desktop / computer-use extension"
  tool_row screenshot "scrot / grim (Linux)" 'command -v scrot || command -v grim' "apt install scrot  |  grim on Wayland"
  tool_row screenshot "xdotool (Linux X11)" 'command -v xdotool' "apt install xdotool"
  tool_row recording "ffmpeg" 'command -v ffmpeg' "brew install ffmpeg  |  apt install ffmpeg"
  tool_row terminal "tmux" 'command -v tmux' "brew install tmux  |  apt install tmux"
  tool_row terminal "expect" 'command -v expect' "brew install expect  |  apt install expect"
  tool_row http "curl" 'command -v curl' "system package"
  tool_row http "httpie" 'command -v http' "brew install httpie"
  tool_row mobile "xcrun simctl (iOS sim)" 'command -v xcrun && xcrun simctl help' "Xcode"
  tool_row mobile "adb (Android)" 'command -v adb' "Android platform-tools"
  tool_row container "docker" 'command -v docker' "Docker Desktop / OrbStack / docker.io"
  echo
  echo "Pick by target: web UI -> a browser MCP or Playwright; CLI/TUI -> tmux or expect plus terminal capture; desktop/game -> screenshot and recording tools; API -> curl/httpie."
  git rev-parse --git-dir >/dev/null 2>&1 || return 0
  local r; r=$(repo_root)
  echo
  echo "MCP servers by scope (none starts with a session; by default its helpers may start the repo's, and user or local ones only when the task's \"mcp\" list names them):"
  echo "  repo (.mcp.json): $([ -f "$r/.mcp.json" ] && jq -r '(.mcpServers // {}) | keys | join(", ")' "$r/.mcp.json")"
  echo "  local: $([ -f "$CLAUDE_JSON" ] && jq -r --arg r "$r" '(.projects[$r].mcpServers // {}) | keys | join(", ")' "$CLAUDE_JSON")"
  echo "  user: $([ -f "$CLAUDE_JSON" ] && jq -r '(.mcpServers // {}) | keys | join(", ")' "$CLAUDE_JSON")"
  echo "A session starts a server by calling its helper agent, mcp-<server>; 'orch tools' itself reports the whole machine."
}

# task_mcp <task json>: the MCP servers a session may start on demand — a JSON array of names, or
# "inherit". Default: the repository's .mcp.json, which the project declares for its own work and
# keeps in git. User- and local-scope servers (mail, routers, cloud billing) carry personal
# credentials and are reachable only when the task names them. None runs at session start.
task_mcp() {
  case "$(jq -r '.mcp | type' <<<"$1")" in
    string) jq -r '.mcp' <<<"$1" ;;
    array) jq -c '.mcp' <<<"$1" ;;
    *) if [ -f "$(repo_root)/.mcp.json" ]; then jq -c '(.mcpServers // {}) | keys' "$(repo_root)/.mcp.json"; else echo '[]'; fi ;;
  esac
}

# helper_names <names json>: the helper agent for each server, as the Agent tool's subagent_type.
helper_names() { jq -r 'map("mcp-" + gsub("[^A-Za-z0-9_-]"; "-")) | join(", ")' <<<"$1"; }

# mcp_launch <run_dir> <session name> <names json>: the session starts with an empty MCP config
# (<name>.json) and gets one helper agent per server it may use (<name>.agents.json, passed with
# --agents): the helper carries the server inline, so it starts when the helper does and stops when
# the helper finishes; --strict-mcp-config does not filter servers passed that way. Both files are
# private — server definitions can carry keys. Lookup follows Claude Code's precedence: local scope,
# then the repository's .mcp.json, then user scope.
mcp_launch() {
  local d="$1" name="$2" names="$3" r f repo='{}' scoped='{"local":{},"user":{}}' out missing
  r=$(repo_root); f="$d/mcp/$name.agents.json"
  [ -f "$r/.mcp.json" ] && repo=$(jq -c '.mcpServers // {}' "$r/.mcp.json")
  [ -f "$CLAUDE_JSON" ] && scoped=$(jq -c --arg r "$r" '{local: (.projects[$r].mcpServers // {}), user: (.mcpServers // {})}' "$CLAUDE_JSON")
  out=$(jq -n --argjson names "$names" --argjson repo "$repo" --argjson s "$scoped" \
    '{mcpServers: (reduce $names[] as $n ({}; . + {($n): ($s.local[$n] // $repo[$n] // $s.user[$n])}))}')
  missing=$(jq -r '.mcpServers | to_entries[] | select(.value == null) | .key' <<<"$out" | tr '\n' ' ')
  [ -z "$missing" ] || die "MCP server not configured in local scope, .mcp.json or user scope: $missing"
  # --agents takes JSON on the command line (a file only with --print), so these definitions are
  # visible to ps on this machine; say so for any that carry env or headers.
  local exposed; exposed=$(jq -r '.mcpServers | to_entries[] | select((.value.env // {} | length) > 0 or (.value.headers // {} | length) > 0) | .key' <<<"$out" | tr '\n' ' ')
  [ -z "$exposed" ] || echo "note: the definitions of ${exposed}carry env or headers and reach the session as a command-line argument, visible to ps on this machine; prefer servers that read their keys from the environment" >&2
  mkdir -p "$d/mcp"
  (umask 077; printf '{"mcpServers":{}}\n' > "$d/mcp/$name.json")
  rm -f "$f"
  [ "$(jq 'length' <<<"$names")" -gt 0 ] || return 0
  (umask 077; jq '.mcpServers | to_entries | map({key: ("mcp-" + (.key | gsub("[^A-Za-z0-9_-]"; "-"))), value: {
      description: ("Carries the " + .key + " MCP server, which starts with this agent and stops when it finishes. Hand it a self-contained task that needs " + .key + "'"'"'s tools; it returns the result and the paths of anything it saved."),
      prompt: ("You carry the " + .key + " MCP server for a teammate in an orchestrated team run. Do exactly the task you are given with that server'"'"'s tools, save screenshots and other files under .scratch/ in the current worktree, and answer with the result, the evidence paths and anything that failed. You change no source files."),
      mcpServers: [{(.key): .value}],
      disallowedTools: ["Agent", "Workflow"]}}) | from_entries' <<<"$out" > "$f")
  chmod 600 "$f"
}

cmd_handoff_put() {
  local d; d=$(run_dir "${1:-}"); local name="${2:-}" file="" by=""
  [ -n "$name" ] || die "handoff-put <run> <name> [--file <path>] [--by-lead \"<source>\"]  (without --file the content comes on stdin)"
  shift 2
  while [ $# -gt 0 ]; do
    case "$1" in
      --file) [ -n "${2:-}" ] || die "--file needs a path"; file="$2"; shift 2 ;;
      --by-lead) [ -n "${2:-}" ] || die "--by-lead needs the source, e.g. \"the DONE message of dev-1\""; by="$2"; shift 2 ;;
      *) die "unknown option $1" ;;
    esac
  done
  # A later round runs under <task name>-r<N> (orch spawn --round N), up to the run's maxRounds.
  jq -e --arg n "$name" '
    (.review.maxRounds // 3) as $max
    | [.tasks[].name] as $names
    | ($names | index($n)) != null
      or ( ($n | capture("^(?<base>.+)-r(?<r>[0-9]+)$")? // null) as $m
           | $m != null and ($names | index($m.base)) != null and ($m.r | tonumber) >= 2 and ($m.r | tonumber) <= $max )
    ' "$d/plan.json" >/dev/null || die "no session named '$name' in the plan (rounds are <task name>-r2 … -r<maxRounds>)"
  local tmp="$d/handoffs/.$name.tmp"
  if [ -n "$file" ]; then
    [ -f "$file" ] || die "no such file $file"
    cat "$file" > "$tmp" || die "could not read $file"
  else
    cat > "$tmp" || die "could not read stdin"
  fi
  [ -s "$tmp" ] || { rm -f "$tmp"; die "empty handoff refused"; }
  mv "$tmp" "$d/handoffs/$name.md"
  if [ -n "$by" ]; then
    { printf 'written by the orchestrator from %s\n\n' "$by"; cat "$d/handoffs/$name.md"; } > "$tmp" && mv "$tmp" "$d/handoffs/$name.md"
    ev "$d" orchestrator "$name" handoff-put allow "written by the orchestrator from $by, $(wc -c < "$d/handoffs/$name.md" | tr -d ' ') bytes"
  else
    ev "$d" handoff-put "$name" handoff allow "$(wc -c < "$d/handoffs/$name.md" | tr -d ' ') bytes"
  fi
  echo "handoff stored: $d/handoffs/$name.md"
}

# cmd_qa_request: the fast flow. qa is optional unless the run is interactive, so a developer that wants
# its work checked adds the qa task itself, through the plan's validation, and tells the lead.
cmd_qa_request() {
  local run="${1:-}" who="${2:-}" what="${3:-}"
  [ -n "$run" ] && [ -n "$who" ] && [ -n "$what" ] || die "qa-request <run> <your name> \"<what to check>\""
  local d; d=$(run_dir "$run")
  local id task role has tmp="$d/plan.edit.json"
  id=$(resolve_task "$d" "$who") || die "no task or session '$who' in run $run"
  task=$(jq -c --arg id "$id" '.tasks[] | select(.id == $id)' "$d/plan.json")
  role=$(jq -r '.role' <<<"$task")
  [ "$role" = developer ] || die "qa-request asks for qa of a developer task; $id is a $role task"
  has=$(jq -r --arg id "$id" "$JQ_DEFS"'first(.tasks[] | as_qa | select(.role == "qa" and .qaOf == $id) | .name) // empty' "$d/plan.json")
  [ -z "$has" ] || die "task $id already has qa task $has; message it what to check"
  jq --arg id "$id" --arg what "$what" --argjson t "$task" '.tasks += [{id: ("qa-" + $id), role: "qa", qaOf: $id, name: ("qa-" + $t.name),
      goal: ("qa of " + $t.name + ", asked for by its developer: " + $what), pathsAllowed: ["qa/" + $t.name + "/**"],
      acceptance: [$what], dependsOn: [$id]} + (if $t.stage == null then {} else {stage: $t.stage} end)]' "$d/plan.json" > "$tmp"
  ( cmd_plan "$run" "$tmp" --replan ) > /dev/null || { rm -f "$tmp"; exit 1; }
  rm -f "$tmp"
  ev "$d" qa-request "$who" "qa-$id" allow "$what"
  echo "message the orchestrator: QA: qa-$id"
}

render_brief() {
  local d="$1" id="$2" round="${3:-1}" budget_override="${4:-}" cont="${5:-}"
  local task; task=$(jq -c --arg id "$id" "$JQ_DEFS"'.tasks[] | select(.id == $id) | as_qa' "$d/plan.json")
  [ -n "$task" ] || die "no task '$id' in plan"
  local dep
  for dep in $(jq -r '.dependsOn[]' <<<"$task"); do
    task_done "$d" "$dep" "$(jq -r '.role' <<<"$task")" || die "task '$id' depends on '$dep', which is not done yet: its handoff must say done, and a developer task must also be accepted (orch accept) before anything but its reviewer, qa or design-reviewer builds on it"
  done
  local gate; gate=$(stage_gate "$d" "$(jq -r '.stage // ""' <<<"$task")")
  [ -z "$gate" ] || die "task '$id' is in stage $(jq -r '.stage' <<<"$task"), which waits for the user's approval of stage $gate (orch approve)"
  gate=$(arch_gate "$d" "$(jq -r '.role' <<<"$task")")
  [ -z "$gate" ] || die "task '$id' waits for the architect: its design task '$gate' is not accepted yet — every task starts from a checked map (orch accept $(basename "$d") $gate runs orch architecture --check in the architect's worktree)"
  local run base orch_name name role goal budget venue max_rounds review_of review_line
  run=$(jq -r '.run' "$d/plan.json"); base=$(jq -r '.baseBranch' "$d/plan.json"); orch_name=$(jq -r '.orchestrator' "$d/plan.json")
  name=$(jq -r '.name' <<<"$task"); role=$(jq -r '.role' <<<"$task"); goal=$(jq -r '.goal' <<<"$task"); budget=$(jq -r '.budget' <<<"$task")
  [ -n "$budget_override" ] && budget="$budget_override"
  venue=$(jq -r '.review.venue // "branch"' "$d/plan.json"); max_rounds=$(jq -r '.review.maxRounds // 3' "$d/plan.json")
  review_of=$(jq -r '.reviewOf // ""' <<<"$task")
  [ "$round" -gt 1 ] && name="$name-r$round"
  if [ "$role" = reviewer ]; then
    local target_name="" target_branch="" target_read
    if [ -n "$review_of" ]; then
      target_name=$(jq -r --arg id "$review_of" '.tasks[] | select(.id == $id) | .name' "$d/plan.json")
      target_branch="the branch of $target_name ($(target_ref "$d" "$target_name"))"
      target_read="git -C $(task_worktree "$d" "$target_name") diff $base...HEAD"
    else
      target_branch="the branch named in your task"
      target_read="git diff $base...<that branch>"
    fi
    if [ "$venue" = pr ]; then
      review_line="review venue: the pull or merge request opened by $target_name — round $round of $max_rounds.
  Read the full diff, then leave every finding as its own thread on the changed line (gh pr review --comment -b … / gh api repos/{owner}/{repo}/pulls/{n}/comments, or glab mr note), plus one summary comment stating blocker / should fix / nit counts.
  Re-review means re-reading the diff from scratch on the new head and answering each of your earlier threads: fixed, not fixed, or new finding. Resolve only threads you confirmed fixed."
    else
      review_line="review venue: $target_branch, read with $target_read — round $round of $max_rounds.
  Findings go into your handoff, most severe first, each with file, line, claim and evidence. On a re-review read the diff again from scratch and mark each earlier finding fixed, not fixed, or new."
    fi
  elif [ "$role" = qa ]; then
    local qa_dev qa_read="git diff $base...<its branch>"
    qa_dev=$(jq -r --arg id "$(jq -r '.qaOf // ""' <<<"$task")" '.tasks[] | select(.id == $id) | .name' "$d/plan.json")
    [ -n "$qa_dev" ] && qa_read="$(target_ref "$d" "$qa_dev"); git -C $(task_worktree "$d" "$qa_dev") diff $base...HEAD"
    review_line="qa of ${qa_dev:-the developer task named in your goal} — round $round of $max_rounds.
  Before the developer writes code: TDD test cases for its task in your allowed paths — every acceptance criterion, edge and failure case, each with its observable result. FYI: $qa_dev with the path, send a partial handoff, and wait for its DONE.
  After DONE, audit its branch ($qa_read): every case covered by a test that fails when the behaviour breaks; nothing skipped, disabled, focused or weakened; no mock standing in for the unit under test; its baseline, red and green runs real — re-run them. Findings go to $qa_dev as Q:, the verdict into your handoff. A later round audits the fixes the same way."
    if [ "$(jq -r '.interactive // false' "$d/plan.json")" = true ]; then
      review_line="$review_line
  Run the application from its worktree the way the repository documents (README, package scripts, Makefile, docker compose), exercise every acceptance criterion as a user would, and capture evidence for each: screenshots, recordings, terminal transcripts, HTTP responses, logs. Evidence goes under .scratch/evidence/ in your worktree, named by criterion; paths go into the handoff.
  Means: run 'orch tools' first and pick from what is available for this target. Nothing is installed by you; when the run has no suitable means, report BLOCKED: with the exact tool and install command from 'orch tools' so the orchestrator can ask the user."
    fi
    if [ "$(jq -r '.authorize.installTools // false' "$d/plan.json")" = true ]; then
      review_line="$review_line
  authorized for this run: installing the verification tooling 'orch tools' lists as missing (and only that)."
    else
      review_line="$review_line
  NOT authorized: installing anything; the guard blocks package installs until the plan authorizes install-tools."
    fi
    if [ "$(jq -r '.authorize.mutateData // false' "$d/plan.json")" = true ]; then
      review_line="$review_line
  authorized for this run: creating or changing data in the app's development databases and services (sign-ups, invites, records); list what you created under 'Left running' in the handoff so it can be cleaned up."
    else
      review_line="$review_line
  NOT authorized: creating or changing data in shared development databases or services. Use the fixtures, throwaway database or test setup the repository provides; a criterion that cannot be exercised without writing shared data is BLOCKED: to the orchestrator."
    fi
  elif [ "$role" = qa-lead ]; then
    if [ "$(jq -r '.phase' <<<"$task")" = author ]; then
      review_line="qa-lead, phase author: acceptance tests for the whole change, from the spec's criteria (or the OpenSpec change's scenarios), in your allowed paths and the repository's test framework. They fail now and pass when the change is done: run them once against $base and paste the red run. Developers make them green and never edit them; an untestable criterion is a Q: to the analyst."
    else
      review_line="qa-lead, phase accept: accept the whole change now that every developer task and stage is done. Run the acceptance suite on the integrated result ($base after the integrator's merges, or the branch your task names), one row per criterion — pass, fail, not run — with the command and its output, then a verdict: ship / not yet. A failure goes to the orchestrator with the test, the command and the output; the orchestrator decides."
    fi
  elif [ "$role" = design-reviewer ]; then
    local dr_dev dr_des
    dr_dev=$(jq -r --arg id "$(jq -r '.designOf // ""' <<<"$task")" '.tasks[] | select(.id == $id) | .name' "$d/plan.json")
    dr_des=$(jq -r '[.tasks[] | select(.role == "designer") | .name] | join(", ")' "$d/plan.json")
    review_line="design review of ${dr_dev:-the task named in your goal} against the brief and tokens of ${dr_des:-the designer} — round $round of $max_rounds.
  Read the design handoff, then the implementation: run it from its worktree${dr_dev:+ ($(target_ref "$d" "$dr_dev"))} or use qa's evidence, capture every screen and state the brief names into .scratch/evidence/, and compare layout, spacing, type, colour, states and motion. Each finding: the design reference, the screenshot, severity. Questions about intent go to ${dr_des:-the designer} as Q:; you edit nothing."
  elif [ "$role" = architect ]; then
    local map_rules="Keep docs/architecture/modules.json — every module with name, doc, paths (globs as in Claude Code: ** any depth, * within one directory) and summary, and ignore for what no module owns — then run 'orch architecture --sync', which writes .claude/rules/architecture/<module>.md: Claude Code loads each one when any session opens a file of that module. Commit the map and the rules on your branch. You are done only when 'orch architecture --check' passes in your worktree: the lead's orch accept runs it again there and refuses a map that fails or is not committed."
    if [ "$(jq -r '.phase' <<<"$task")" = design ]; then
      review_line="architecture map: $(arch_status "$base"). Phase design — every other task of this run waits for your accepted map. First run 'orch architecture --check' in your worktree: it compares the map with the code as it is now. No map: build it, as detailed as the code allows, since every role relies on it. A map that fails: bring it up to date from git diff <built-at>..HEAD, only what changed, and move built-at to HEAD. $map_rules Then design this change against it in docs/architecture/decisions/$run.md (or the OpenSpec change's design.md). 'orch architecture' shows the size of the job and the graph tools this stack has. Stay reachable: teammates ask you about structure."
    else
      review_line="architecture map: $(arch_status "$base"). Phase update: the change has landed; update the map to what shipped, from the merged diff, and set built-at to the new commit of $base. $map_rules"
    fi
  elif [ "$role" = integrator ] && [ "$venue" = pr ]; then
    review_line="review venue: pull request. The task branches carry PRs against $base; merge them in dependency order (gh pr merge <n> --merge, or locally and then push $base when authorized — a pushed merge closes its PR). You open no PR of your own for $base; put the merged PR numbers in your handoff."
  elif [ "$venue" = pr ] && [ "$role" != researcher ]; then
    review_line="review venue: pull request. When your work is ready, push your branch and open a PR against $base (gh pr create --draft --base $base, or glab mr create) with the acceptance criteria as a checklist, then put the PR link in your handoff and in your DONE message. Reviewers comment in threads there; answer each thread with what you changed and the commit that changed it."
  elif [ "$(jq -r '.chore // false' <<<"$task")" = true ]; then
    review_line="review: a chore task, with no reviewer and no qa — the orchestrator reads your branch diff against $base itself before it accepts; keep the diff small and say in your handoff what it changes."
  else
    review_line="review venue: branch. A reviewer will read your branch diff against $base and file findings through the orchestrator; answer its questions with file and line."
  fi
  local notes="" note_names
  note_names=$(jq -r '[.resources[]?] | join(", ")' <<<"$task")
  [ -z "$note_names" ] || notes="$notes
resources you hold: $note_names — no other session, of this run or another, may use or restart them while you work; ask the orchestrator before you touch any other shared one"
  if [ "$role" = developer ]; then
    note_names=$(jq -r --arg id "$id" '[.tasks[] | select(.role == "qa" and .qaOf == $id) | .name] | join(", ")' "$d/plan.json")
    if [ -n "$note_names" ]; then notes="$notes
TDD cases: $note_names writes them before you start; wait for its FYI, cover every case, answer its audit"
    else notes="$notes
qa on request: no qa task covers yours. When it has logic below the acceptance tests, risky edge cases, a UI state that needs running to check, run orch qa-request $run $name \"<what to check>\" and send the orchestrator the QA: line it prints"
    fi
    note_names=$(jq -r '[.tasks[] | select(.role == "qa-lead" and .phase == "author") | .pathsAllowed[]] | unique | join(", ")' "$d/plan.json")
    [ -n "$note_names" ] && notes="$notes
acceptance tests (the qa-lead's): $note_names — never edit them; the change is done when they pass"
  fi
  if [ "$role" != architect ]; then
    local arch_name awt map_dir
    arch_name=$(jq -r 'first(.tasks[] | select(.role == "architect" and .phase == "design") | .name) // first(.tasks[] | select(.role == "architect") | .name) // empty' "$d/plan.json")
    if [ -n "$arch_name" ]; then
      awt=$(task_worktree "$d" "$arch_name")
      # Until the integrator merges the architect's branch, the current map is in its worktree, not in yours.
      if [ -d "$awt/docs/architecture" ]; then map_dir="$awt/docs/architecture/ (the architect's worktree: current for this run, while the copy in yours may be older)"; else map_dir="docs/architecture/"; fi
      notes="$notes
architecture map: $map_dir — read README.md, then $(brief_modules "$d" "$task" "$awt" "$base"). Structure questions go to $arch_name"
      [ "$role" = integrator ] && notes="$notes
the architect's branch: $(basename "$awt") — merge it too: it carries the map and the rules this run was designed against"
    fi
  fi
  [ "$role" = integrator ] && notes="$notes
$(merge_list "$d" "$id" "$base")"
  if [ "$(jq -r '.mode // "single"' "$d/plan.json")" = staged ]; then
    notes="$notes
stage: $(jq -r '.stage' <<<"$task") of $(jq -r '.stages | join(" → ")' "$d/plan.json"); the user approves each stage before the next one starts"
  fi
  local mcp mcp_line
  mcp=$(task_mcp "$task")
  case "$mcp" in
    inherit) mcp_line="MCP servers: inherited — every server configured on this machine and in the repository" ;;
    '[]') mcp_line="MCP servers: none — this task was given none; ask the orchestrator if the work needs one" ;;
    *) mcp_line="MCP servers start on demand: none runs in this session. When the work needs one, call the Agent tool with subagent_type mcp-<server> and a self-contained task; the server runs only while that helper works. Helpers: $(helper_names "$mcp")" ;;
  esac
  local base_line auth_line wt
  wt=$(task_worktree "$d" "$(jq -r '.name' <<<"$task")")
  if [ "$role" = integrator ]; then
    base_line="base branch: $base — you merge into it; work on it only through your own worktree"
    if [ "$(jq -r '.authorize.pushBase // false' "$d/plan.json")" = true ]; then
      auth_line="authorized for this run: pushing $base"
    else
      auth_line="NOT authorized: pushing $base — merge locally, then report DONE; the orchestrator gets the user's word and runs orch authorize"
    fi
    if [ "$(jq -r '.authorize.deleteMerged // false' "$d/plan.json")" = true ]; then
      auth_line="$auth_line; deleting merged branches and worktrees after you verify every ref is contained in $base"
    fi
  else
    base_line="base branch: $base — never commit to it"
    auth_line="the integrator owns $base; never push or merge it"
  fi
  cat <<EOF
# Team run "$run" · you are $name · role: $role
orchestrator: $orch_name — address it with SendMessage by exactly this name
rules (read first, before any tool call): $RULES
run dir: $d
your handoff (mandatory before you stop): $d/handoffs/$name.md
  send it, don't write it there: put it in .scratch/handoff.md in your worktree, then run exactly
  orch handoff-put $run $name < .scratch/handoff.md
  alone in its call; the guard lets that through even when you are paused or out of budget. A quoted heredoc works
  too, but Claude Code's own worktree isolation may refuse a heredoc whose text names git commands.
scratch files and logs: .scratch/ inside your own worktree — never /tmp, where parallel sessions collide
your worktree: $wt on branch $(basename "$wt"), made by orch from $base; you start inside it. Stay there: never call EnterWorktree and never make another worktree — once nobody in the run can still need you the orchestrator removes this session with claude rm, which keeps this worktree and its branch but would delete a worktree the session made itself
$base_line
$auth_line
$review_line
allowed paths (relative to your worktree; the guard enforces them): $(jq -r '.pathsAllowed | join(", ")' <<<"$task")
budget: $budget guarded tool calls (Bash, Edit, Write and every MCP tool); at 80% the guard holds one call and asks for a partial handoff, at 100% it stops you — plan for it
$mcp_line$notes
acceptance the orchestrator will check itself:
$(jq -r '.acceptance[] | "- " + .' <<<"$task")

roster (SendMessage by name):
$(jq -r --arg me "$name" '.tasks[] | select(.name != $me) | "- \(.name) (\(.role)): \(.goal | .[0:110])"' "$d/plan.json")

## Task
$goal

## Handoffs you depend on
EOF
  local depname
  for dep in $(jq -r '.dependsOn[]' <<<"$task"); do
    depname=$(jq -r --arg id "$dep" '.tasks[] | select(.id == $id) | .name' "$d/plan.json")
    printf '\n### %s (%s)\n%s — read its files there until the integrator merges it; handoff %s\n' "$depname" "$dep" "$(target_ref "$d" "$depname")" "$(basename "$(latest_handoff "$d" "$depname")")"
    cat "$(latest_handoff "$d" "$depname")"
  done
  [ "$(jq -r '.dependsOn | length' <<<"$task")" -eq 0 ] && echo "(none)"
  if [ -n "$cont" ]; then
    local prev; prev=$(jq -r '.name' <<<"$task")
    [ "$round" -gt 2 ] && prev="$prev-r$((round - 1))"
    printf '\n## Continue: %s stopped at its budget before it was done\n' "$prev"
    printf 'Its work is in your worktree, committed or not: start from git status, git diff and git log %s..HEAD, and finish the task from there; do not start over. Its handoff, if it sent one:\n' "$base"
    if [ -f "$d/handoffs/$prev.md" ]; then cat "$d/handoffs/$prev.md"; else echo "(no handoff from $prev)"; fi
  elif [ "$round" -gt 1 ] && [ "$role" = developer ]; then
    # The developer's own previous handoff says what it did; what it must answer is what the tasks covering it found.
    printf '\n## Findings on your previous round: answer each — fixed, not fixed, or superseded\n'
    local cov covh
    for cov in $(jq -r --arg id "$id" '.tasks[] | select(.reviewOf == $id or .designOf == $id or .qaOf == $id) | .name' "$d/plan.json"); do
      covh=$(latest_handoff "$d" "$cov")
      printf '\n### %s (%s)\n' "$cov" "$(basename "$covh")"
      if [ -f "$covh" ]; then cat "$covh"; else echo "(no handoff from $cov yet)"; fi
    done
  elif [ "$round" -gt 1 ]; then
    local prev; prev=$(jq -r '.name' <<<"$task")
    [ "$round" -gt 2 ] && prev="$prev-r$((round - 1))"
    printf '\n## Previous round (%s): answer each finding — fixed, not fixed, or superseded\n' "$prev"
    if [ -f "$d/handoffs/$prev.md" ]; then cat "$d/handoffs/$prev.md"; else echo "(no handoff from $prev)"; fi
  fi
  cat <<EOF

## First steps
1. Read the rules file. 2. Read the task and the handoffs above. 3. Check you are in your worktree ($wt). 4. Send the orchestrator one line: "STARTED: $name, plan in three bullets" — it starts watching you only after this. 5. Work. 6. Send the handoff with orch handoff-put, then message the orchestrator "DONE: $name" or "BLOCKED: <what you need, from whom>". Silence is not a report: the orchestrator acts on your messages, not on your idleness.
EOF
}

# brief_modules <run_dir> <task json> <architect worktree> <base>: which module docs the task needs —
# those whose paths hold a file the task may edit, or, for a role that owns no code, the task it covers.
brief_modules() {
  local d="$1" task="$2" awt="$3" base="$4" r mj files cover globs
  r=$(repo_root)
  if [ -f "$awt/docs/architecture/modules.json" ]; then
    mj=$(cat "$awt/docs/architecture/modules.json"); files=$(git -C "$awt" ls-files)
  else
    mj=$(git -C "$r" show "$base:docs/architecture/modules.json" 2>/dev/null); files=$(git -C "$r" ls-tree -r --name-only "$base")
  fi
  jq -e '.modules | length > 0' >/dev/null 2>&1 <<<"$mj" || { printf 'the module docs your paths lead to'; return; }
  cover=$(jq -r '.reviewOf // .verifies // .qaOf // .designOf // ""' <<<"$task")
  globs=$(jq -c --arg c "$cover" --slurpfile p "$d/plan.json" '(.pathsAllowed // []) + (if $c == "" then [] else [$p[0].tasks[] | select(.id == $c) | .pathsAllowed // [] | .[]] end)' <<<"$task")
  printf '%s\n' "$files" | jq -R . | jq -rs --argjson mj "$mj" --argjson g "$globs" "$JQ_GLOB"'
    [ .[] | select(. as $f | any($g[]; . as $x | $f | test($x | guard_re))) ] as $mine
    | [ $mj.modules[] | . as $m | select(any($mine[]; matches_any($m.paths))) | .doc ] as $docs
    | if ($docs | length) == 0 then "the module docs your paths lead to (modules.json maps none of your files)"
      elif ($docs | length) == ($mj.modules | length) and ($docs | length) > 1 then "the modules as the work needs them: your paths span every module"
      else "only the modules your task touches: " + ($docs | join(", ")) end'
}

# merge_list <run_dir> <integrator's task id> <base>: every task branch of the run with commits not in
# base, in the order dependsOn implies (plan order among tasks that are ready together), with its head.
merge_list() {
  local d="$1" root tname trole branch out=""
  root=$(repo_root)
  while read -r tname trole; do
    branch=$(basename "$(task_worktree "$d" "$tname")")
    git -C "$root" rev-parse -q --verify "refs/heads/$branch" >/dev/null || continue
    ! git -C "$root" merge-base --is-ancestor "$branch" "$3" 2>/dev/null || continue
    out="$out
- $tname ($trole): branch $branch, head $(git -C "$root" rev-parse "$branch")"
  done <<EOF
$(jq -r --arg me "$2" '
  .tasks as $t
  | {done: [], left: [$t[] | select(.id != $me)]}
  | until((.left | length) == 0;
      . as $s
      | [ $s.left[] | select(all((.dependsOn // [])[]; . as $x | ($s.done | index($x)) != null or $x == $me)) ] as $r
      | if ($r | length) == 0 then .done += [.left[].id] | .left = [] else .done += [$r[].id] | .left -= $r end)
  | .done[] as $id | $t[] | select(.id == $id) | "\(.name) \(.role)"' "$d/plan.json")
EOF
  printf 'branches to merge (every task branch of the run with commits not in %s, in dependency order; heads as of this brief):%s' "$3" "${out:-
(none yet)}"
}

cmd_brief() { local d; d=$(run_dir "${1:-}"); [ -n "${2:-}" ] || die "brief <run> <task-id>"; render_brief "$d" "$2" "${3:-1}"; }

# task_worktree <run_dir> <task name>: the worktree orch makes for a task, named and branched
# <run>-<task name>; every round of the task works there.
task_worktree() { printf '%s/.claude/worktrees/%s-%s' "$(repo_root)" "$(basename "$1")" "$2"; }

# make_worktree <run_dir> <task name>: the session is started inside a worktree orch made, because
# claude rm keeps that one, while a worktree the session made itself with EnterWorktree is deleted
# with its branch once its commits are pushed or merged — past the delete-merged gate and the
# containment report of orch close.
make_worktree() {
  local wt branch root
  wt=$(task_worktree "$1" "$2"); branch=$(basename "$wt")
  if [ ! -d "$wt" ]; then
    root=$(repo_root)
    if git -C "$root" rev-parse -q --verify "refs/heads/$branch" >/dev/null; then
      git -C "$root" worktree add -q "$wt" "$branch" >&2 || die "could not add the worktree $wt on $branch"
    # Pushed from another machine: starting from base would drop that work at the next push.
    elif git -C "$root" rev-parse -q --verify "refs/remotes/origin/$branch" >/dev/null; then
      git -C "$root" worktree add -q --track -b "$branch" "$wt" "origin/$branch" >&2 || die "could not make the worktree $wt from origin/$branch"
      echo "worktree $wt: branch $branch made from origin/$branch, which it tracks" >&2
    else
      git -C "$root" worktree add -q -b "$branch" "$wt" "$(jq -r '.baseBranch' "$1/plan.json")" >&2 || die "could not make the worktree $wt"
    fi
  fi
  printf '%s' "$wt"
}

# finished_sessions <run_dir>: sessions no open task can still need. A session is needed while its
# task is open, and while a task that builds on it, directly or through others, is open: the
# integrator asks developers about conflicts, developers ask the designer. The analyst, researcher
# and architect answer anyone, so they stay until no task is open.
finished_sessions() {
  local open; open=$(open_tasks "$1") || return 1
  jq -r --arg open "$open" --slurpfile p "$1/plan.json" "$JQ_DEFS"'
    ($open | split("\n") | map(select(. != ""))) as $o
    | $p[0] as $plan
    | .[] | select((.removedAt // "") == "")
    | .taskId as $t
    | select(($o | index($t)) == null)
    | (first($plan.tasks[] | select(.id == $t) | .role) // "") as $role
    | select(if ($role == "analyst" or $role == "researcher" or $role == "architect") then ($o | length) == 0
             else [$o[] as $x | closure($plan; $x) | index($t)] | all(. == null) end)
    | .name' "$1/sessions.json"
}

# remove_sessions <run_dir> <records file> <name>...: claude rm each session not removed yet, so
# finished sessions leave claude agents and ListAgents. The record stays, marked removedAt, so its
# task is never offered again. A session without a worktree orch made is left alone: claude rm would
# delete the worktree it made itself, branch included. Fails when a session was kept.
remove_sessions() {
  local d="$1" f="$2" name id out n=0 kept=0; shift 2
  for name in "$@"; do
    id=$(jq -r --arg n "$name" 'first(.[] | select(.name == $n and (.removedAt // "") == "") | .id) // empty' "$f")
    [ -n "$id" ] || continue
    if [ -z "$(jq -r --arg n "$name" 'first(.[] | select(.name == $n)) | .worktree // ""' "$f")" ]; then
      echo "kept $name: it made its own worktree, which claude rm would delete with its branch; once that branch is settled: claude rm $id" >&2
      kept=$((kept + 1)); continue
    fi
    # A session claude no longer knows (removed by hand) counts as removed.
    if ! out=$(claude rm "$id" 2>&1) && ! printf '%s' "$out" | grep -q '^No job matching'; then
      printf 'kept %s: %s\n' "$name" "$out" >&2
      kept=$((kept + 1)); continue
    fi
    lock_run "$d"
    jq --arg n "$name" --arg t "$(now)" 'map(if .name == $n then .removedAt = $t else . end)' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
    unlock_run "$d"
    ev "$d" orchestrator "$name" rm allow "$id"
    n=$((n + 1))
  done
  [ "$n" -eq 0 ] || echo "removed $n session(s) from claude agents — worktrees and branches stay, transcripts stay for claude --resume"
  [ "$kept" -eq 0 ]
}

# backfill_session_ids <run_dir>: an empty sessionId gets the full id the guard logged under the short
# one. Only a live status poll filled it before, and a session removed first kept it empty for good.
backfill_session_ids() {
  jq -e 'map(select((.sessionId // "") == "")) | length > 0' "$1/sessions.json" >/dev/null 2>&1 || return 0
  local ids; ids=$(cut -d'|' -f2 "$1/events.log" 2>/dev/null | awk '!s[$0]++' | jq -R . | jq -sc .)
  lock_run "$1"
  jq --argjson e "${ids:-[]}" 'map(. as $r | if ($r.sessionId // "") == "" then .sessionId = (first($e[] | select(startswith($r.id + "-"))) // "") else . end)' \
    "$1/sessions.json" > "$1/sessions.json.tmp" && mv "$1/sessions.json.tmp" "$1/sessions.json"
  unlock_run "$1"
}

cmd_rm() {
  local d; d=$(run_dir "${1:-}"); local who="${2:-}" names
  case "$who" in
    '') die "rm <run> <name|--settled|all>" ;;
    all) names=$(jq -r '.[].name' "$d/sessions.json") ;;
    --settled) names=$(finished_sessions "$d") || die "could not work out which sessions are finished; nothing removed" ;;
    *)
      jq -e --arg n "$who" 'map(select(.name == $n)) | length > 0' "$d/sessions.json" >/dev/null || die "no session named '$who' in run ${1:-}"
      names="$who" ;;
  esac
  need claude
  backfill_session_ids "$d"
  # shellcheck disable=SC2086  # one session name per word
  remove_sessions "$d" "$d/sessions.json" $names
}

# listed_sessions <run_dir>: the run's sessions, forgotten ones included, that claude agents still
# lists, as "<name> <id>" lines. Fails when claude agents cannot be read.
listed_sessions() {
  local live f files=()
  live=$(claude agents --json --all 2>/dev/null) || return 1
  for f in "$1/sessions.json" "$1/forgotten.json"; do [ -f "$f" ] && files+=("$f"); done
  jq -s -r --argjson a "$live" 'add | .[] | select(.id as $i | $a | map(.id) | index($i)) | "\(.name) \(.id)"' "${files[@]}"
}

spawn_one() {
  local d="$1" id="$2" dry="$3" round="${4:-1}" budget="${5:-}" cont="${6:-}"
  local task name role model effort max_rounds
  task=$(jq -c --arg id "$id" "$JQ_DEFS"'.tasks[] | select(.id == $id) | as_qa' "$d/plan.json")
  [ -n "$task" ] || die "no task '$id' in plan"
  # A later round usually needs less than the first; --budget sets this session's own brake.
  [ -n "$budget" ] && task=$(jq -c --argjson b "$budget" '.budget = $b' <<<"$task")
  max_rounds=$(jq -r '.review.maxRounds // 3' "$d/plan.json")
  # A continuation finishes the same round's work, so it answers no review and takes none of its rounds.
  [ -n "$cont" ] || [ "$round" -le "$max_rounds" ] || die "round $round exceeds the run's maxRounds ($max_rounds); the orchestrator decides what happens after the last round — accept with the findings recorded, or re-scope the task"
  name=$(jq -r '.name' <<<"$task"); role=$(jq -r '.role' <<<"$task"); model=$(jq -r '.model' <<<"$task"); effort=$(jq -r '.effort' <<<"$task")
  local task_name="$name"
  [ "$round" -gt 1 ] && name="$name-r$round"
  if jq -e --arg n "$name" 'map(select(.name == $n)) | length > 0' "$d/sessions.json" >/dev/null; then die "session '$name' is already registered; for another review round use --round $((round+1))"; fi
  local brief; brief=$(render_brief "$d" "$id" "$round" "$budget" "$cont") || exit 1
  local extra=""
  [ -n "${ORCH_PERMISSION_MODE:-}" ] && extra="--permission-mode $ORCH_PERMISSION_MODE"
  local mcp agents_file=""
  mcp=$(task_mcp "$task")
  case "$mcp" in
    inherit) ;;
    '['*) mcp_launch "$d" "$name" "$mcp"
          extra="$extra --mcp-config $d/mcp/$name.json --strict-mcp-config"
          [ -f "$d/mcp/$name.agents.json" ] && agents_file="$d/mcp/$name.agents.json" ;;
    *) die "task '$id': mcp must be a list of server names or \"inherit\", got $mcp" ;;
  esac
  local argv=(env -u CLAUDE_CODE_CHILD_SESSION claude --agent "orchestrator:$role" --bg --name "$name" --model "$model" --effort "$effort" --settings "$SPAWN_SETTINGS")
  # shellcheck disable=SC2206  # $extra is deliberately word-split
  argv+=($extra)
  if [ "$dry" -eq 1 ]; then
    # The helper agents are printed as the file they are read from: server definitions may carry keys.
    local a cmdline; cmdline="cd $(shq "$(task_worktree "$d" "$task_name")") &&"
    for a in "${argv[@]}"; do cmdline="$cmdline $(shq "$a")"; done
    [ -z "$agents_file" ] || cmdline="$cmdline --agents \"\$(cat $(shq "$agents_file"))\""
    printf '%s "<brief, %s bytes>" budget=%s\n' "$cmdline" "$(printf '%s' "$brief" | wc -c | tr -d ' ')" "$(jq -r '.budget' <<<"$task")"
    return 0
  fi
  need claude
  local out sid_short wt agents_args=() fresh=0
  [ -n "$agents_file" ] && agents_args=(--agents "$(cat "$agents_file")")
  [ -d "$(task_worktree "$d" "$task_name")" ] || fresh=1
  # The spawns of a wave run in parallel; git worktree add is serialized with the run's lock.
  lock_run "$d"
  wt=$(make_worktree "$d" "$task_name") || { unlock_run "$d"; exit 1; }
  unlock_run "$d"
  # Outside the lock: an install can take longer than a waiting spawn gives the lock.
  [ "$fresh" -eq 0 ] || run_setup "$d" "$task_name" "$wt"
  out=$(cd "$wt" && "${argv[@]}" ${agents_args[@]+"${agents_args[@]}"} "$brief" 2>&1 | strip_ansi)
  sid_short=$(printf '%s\n' "$out" | sed -n 's/.*backgrounded · \([0-9a-f]\{8\}\).*/\1/p' | head -1)
  if [ -z "$sid_short" ]; then
    # Unregistered, the session would run outside every guard rule; it is stopped before orch gives up.
    local stray s
    stray=$(claude agents --json --all 2>/dev/null | jq -r --arg n "$name" '.[] | select(.name == $n) | .id // empty' 2>/dev/null)
    for s in $stray; do claude stop "$s" >/dev/null 2>&1 || echo "note: claude stop $s failed" >&2; done
    die "could not parse the session id from claude --bg output:
$out
${stray:+stopped the session claude agents lists as $name: $(printf '%s' "$stray" | tr '\n' ' ')}${stray:-claude agents lists no session named $name; if one started, stop it by hand}"
  fi
  # Registered by the short id claude --bg printed, the start of the full session id: the guard
  # recognises the session by it and orch status fills in the full id. Polling claude agents for the
  # full id cost minutes per session under load.
  lock_run "$d"
  jq --arg id "$id" --arg name "$name" --arg role "$role" --arg short "$sid_short" --arg t "$(now)" --arg wt "$wt" --argjson task "$task" \
     '. + [{taskId:$id, name:$name, role:$role, id:$short, sessionId:"", worktree:$wt, pathsAllowed:$task.pathsAllowed, budget:$task.budget, spawnedAt:$t}]' \
     "$d/sessions.json" > "$d/sessions.json.tmp" && mv "$d/sessions.json.tmp" "$d/sessions.json"
  unlock_run "$d"
  printf '%s\n' "$(jq -c --arg n "$name" 'map(select(.name == $n)) | .[0]' "$d/sessions.json")"
  printf 'next: end your turn and wait for "STARTED: %s"; subscribe with notify_when_idle once, after STARTED arrives, and never again\n' "$name" >&2
}

cmd_spawn() {
  local d; d=$(run_dir "${1:-}"); shift || true
  local dry=0 wave=0 id="" round="" budget=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry=1 ;;
      --wave) wave=1 ;;
      --round)
        case "${2:-}" in ''|*[!0-9]*) die "--round needs a round number, 1 or more" ;; esac
        [ "$2" -ge 1 ] || die "--round needs a round number, 1 or more"
        round="$2"; shift ;;
      --budget)
        case "${2:-}" in ''|*[!0-9]*) die "--budget needs a number of tool calls" ;; esac
        budget="$2"; shift ;;
      -*) die "unknown option $1" ;;
      *) id="$1" ;;
    esac; shift
  done
  local v; v=$(version_drift "$d"); [ -z "$v" ] || echo "orch: warning: $v" >&2
  load_warning "$d"
  if [ "$wave" -eq 1 ]; then
    [ -z "$round" ] && [ -z "$budget" ] || die "--wave spawns every ready task at round 1 on its plan budget; --round and --budget are for one task"
    local t pids="" p fail=0 run ready max at n left
    run=$(jq -r '.run' "$d/plan.json"); ready=$(cmd_ready "$run")
    max=$(jq -r '.maxParallel // empty' "$d/plan.json")
    if [ -n "$max" ] && [ -n "$ready" ]; then
      at=$(at_work "$d"); n=$((max - at)); [ "$n" -gt 0 ] || n=0
      left=$(printf '%s\n' $ready | awk -v n="$n" 'NR > n' | tr '\n' ' ')
      ready=$(printf '%s\n' $ready | awk -v n="$n" 'NR <= n')
      [ -z "$left" ] || echo "orch: maxParallel $max: $at at work; left for the next orch spawn $run --wave: ${left% }" >&2
    fi
    cross_run_overlap "$d" "$(jq -c --arg r "$ready" '[.tasks[] | select(.id as $id | $r | split("\n") | index($id))]' "$d/plan.json")"
    # The tasks of a wave launch in parallel: each claude --bg takes seconds, and far more under load.
    for t in $ready; do spawn_one "$d" "$t" "$dry" 1 & pids="$pids $!"; done
    [ -n "$pids" ] || echo "no ready task to spawn"
    for p in $pids; do wait "$p" || fail=$((fail + 1)); done
    [ "$fail" -eq 0 ] || die "$fail of the wave's spawns failed; the messages above say why"
  else
    [ -n "$id" ] || die "spawn <run> <task-id> [--round N] [--budget N] | --wave"
    cross_run_overlap "$d" "$(jq -c --arg id "$id" '[.tasks[] | select(.id == $id)]' "$d/plan.json")"
    spawn_one "$d" "$id" "$dry" "${round:-1}" "$budget"
  fi
}

# at_work <run_dir>: the run's sessions still working — not removed, and without a handoff that says
# done, blocked or failed.
at_work() {
  local name h n=0
  for name in $(jq -r '.[] | select((.removedAt // "") == "") | .name' "$1/sessions.json"); do
    h="$1/handoffs/$name.md"
    if [ -f "$h" ]; then case "$(handoff_word "$h")" in done|blocked|failed) continue ;; esac; fi
    n=$((n + 1))
  done
  echo "$n"
}

# load_warning <run_dir>: sessions spawned on a machine already past the plan's maxLoad per CPU starve
# each other's builds and tests into timeouts.
load_warning() {
  local max cpus load
  max=$(jq -r '.maxLoad // empty' "$1/plan.json"); [ -n "$max" ] || return 0
  cpus=$(getconf _NPROCESSORS_ONLN)
  # "load averages: 2.49 2.41 2.35" on macOS, "load average: 0.52, 0.58, 0.59" on Linux.
  load=$(uptime | sed 's/.*load average[s]*: *//' | awk -F'[ ,]+' '{print $1}')
  awk -v l="$load" -v m="$max" -v c="$cpus" 'BEGIN { exit !(l > m * c) }' || return 0
  echo "orch: warning: load average $load is above maxLoad $max × $cpus CPUs; sessions spawned now slow each other down — wait, or spawn fewer (maxParallel)" >&2
}

# run_setup <run_dir> <task name> <worktree>: the plan's setup commands, in order, in a worktree orch just
# made — the installs every session would otherwise spend its budget on. Each is logged with its exit
# code; the first that fails ends the setup, and the session starts anyway.
run_setup() {
  local i n c rc log="$1/setup/$2.log"
  n=$(jq '.setup // [] | length' "$1/plan.json"); [ "$n" -gt 0 ] || return 0
  mkdir -p "$1/setup"
  i=0
  while [ "$i" -lt "$n" ]; do
    c=$(jq -r --argjson i "$i" '.setup[$i]' "$1/plan.json")
    (cd "$3" && sh -c "$c") < /dev/null >> "$log" 2>&1; rc=$?
    if [ "$rc" -ne 0 ]; then
      ev "$1" orchestrator "$2" setup fail "exit $rc: $c"
      echo "orch: warning: setup command failed in $3 (exit $rc): $c — output in $log; the commands after it did not run, and the session starts anyway" >&2
      return 0
    fi
    ev "$1" orchestrator "$2" setup ok "exit 0: $c"
    i=$((i + 1))
  done
}

# cmd_continue: a developer stopped by its budget leaves its work uncommitted in its worktree; the next
# round's session starts there and finishes it, so the lead does not finish it by hand.
cmd_continue() {
  local run="${1:-}" d; d=$(run_dir "$run"); shift || true
  local id="" budget="" dry=0 name round
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry=1 ;;
      --budget)
        case "${2:-}" in ''|*[!0-9]*) die "--budget needs a number of tool calls" ;; esac
        budget="$2"; shift ;;
      -*) die "unknown option $1" ;;
      *) id="$1" ;;
    esac; shift
  done
  [ -n "$id" ] || die "continue <run> <task-id|name> [--budget N] [--dry-run]"
  id=$(resolve_task "$d" "$id") || die "no task or session '$id' in plan"
  [ "$(jq -r --arg id "$id" '.tasks[] | select(.id == $id) | .role' "$d/plan.json")" = developer ] || die "continue is for a developer task, and $id is not one; another round of it is orch spawn $run $id --round N"
  name=$(jq -r --arg id "$id" '.tasks[] | select(.id == $id) | .name' "$d/plan.json")
  round=$(cat "$d/sessions.json" "$d/forgotten.json" 2>/dev/null | jq -s -r --arg t "$id" --arg n "$name" \
    '[add | .[] | select(.taskId == $t) | .name | if . == $n then 1 else (ltrimstr($n + "-r") | tonumber? // 1) end] | max // 0')
  [ "$round" -gt 0 ] || die "task $id was never spawned, so there is nothing to continue; orch spawn $run $id"
  round=$((round + 1))
  spawn_one "$d" "$id" "$dry" "$round" "$budget" continue
  [ "$dry" -eq 1 ] || ev "$d" orchestrator "$id" continue allow "$name-r$round"
}

# task_calls <run_dir> <task-id>: guarded calls of every session the task has had, forgotten ones included;
# each round's budget starts from zero, so only this sum shows what the task has cost.
task_calls() {
  local keys n
  keys=$(cat "$1/sessions.json" "$1/forgotten.json" 2>/dev/null | jq -s -r --arg t "$2" \
    '[add | .[] | select(.taskId == $t) | if (.sessionId // "") == "" then .id + "[^|]*" else .sessionId end] | join("|")')
  [ -n "$keys" ] || { echo 0; return; }
  n=$(grep -c -E "^[^|]*\|($keys)\|[^|]*\|[^|]*\|allow\|" "$1/events.log" 2>/dev/null || true); echo "${n:-0}"
}

# ctx_size <session id or its prefix>: the context of the session's last turn (input, cache read and cache
# write of its last usage by time) in thousands, over its main transcripts; subagents keep contexts of their own.
ctx_size() {
  local f files=()
  while IFS= read -r f; do files+=("$f"); done < <(find "$PROJECTS_DIR" -maxdepth 2 -name "$1*.jsonl" 2>/dev/null)
  [ ${#files[@]} -gt 0 ] || return 0
  grep -h '"usage"' "${files[@]}" \
    | jq -r 'select(.type == "assistant" and .message.usage != null) | .message.usage as $u
        | [(.timestamp // ""), (($u.input_tokens // 0) + ($u.cache_read_input_tokens // 0) + ($u.cache_creation_input_tokens // 0))] | @tsv' 2>/dev/null \
    | sort -s -t "$(printf '\t')" -k1,1 | sed -n '$p' | awk -F'\t' '{ printf "%dk", ($2 + 500) / 1000 }'
}

cmd_status() {
  local d; d=$(run_dir "${1:-}"); local live=1
  [ "${2:-}" = --no-live ] && live=0
  local agents='[]'
  if [ "$live" -eq 1 ] && command -v claude >/dev/null 2>&1; then agents=$(claude agents --json --all 2>/dev/null || echo '[]'); fi
  if [ "$live" -eq 1 ] && jq -e 'map(select((.sessionId // "") == "")) | length > 0' "$d/sessions.json" >/dev/null 2>&1; then
    lock_run "$d"
    jq --argjson a "$agents" 'map(. as $r | if ($r.sessionId // "") == "" then .sessionId = (first($a[] | select(.id == $r.id) | .sessionId) // "") else . end)' \
      "$d/sessions.json" > "$d/sessions.json.tmp" && mv "$d/sessions.json.tmp" "$d/sessions.json"
    unlock_run "$d"
  fi
  printf '%-16s %-11s %-9s %-8s %-9s %-8s %-5s %-6s %s\n' NAME ROLE ID STATE HANDOFF CALLS TASK CTX LAST_EVENT
  jq -r '.[] | [.name, .role, .id, (if (.sessionId // "") == "" then "-" else .sessionId end), (.budget|tostring), .taskId, (.removedAt // "")] | @tsv' "$d/sessions.json" | while IFS="$(printf '\t')" read -r name role id sid budget taskid removed; do
    local state calls last hs mark key tcalls ctx
    # Until its full id is known a session's lines are found by its short id.
    if [ "$sid" = - ]; then key="${id}[^|]*"; else key="$sid"; fi
    state=$(jq -r --arg id "$id" '.[] | select(.id == $id) | .state // "?"' <<<"$agents" | head -1); [ -n "$state" ] || state="-"
    [ -z "$removed" ] || state=removed
    calls=$(grep -c "^[^|]*|$key|[^|]*|[^|]*|allow|" "$d/events.log" 2>/dev/null || true); calls=${calls:-0}
    tcalls=$(task_calls "$d" "$taskid")
    if [ "$sid" = - ]; then ctx=$(ctx_size "$id"); else ctx=$(ctx_size "$sid"); fi
    # The last event of any kind, not the last block: a stale "Stop|no handoff" hid a handoff written afterwards.
    # By the name column: orch handoff-put logs no session id.
    last=$(awk -F'|' -v n="$name" '$3 == n' "$d/events.log" 2>/dev/null | sed -n '$p' | cut -d'|' -f4,5,6 | cut -c1-58)
    hs=$(handoff_state "$d" "$name" "$taskid")
    # "!" from 80% of the budget: time to look before the guard stops the session mid-thought.
    mark=""; [ "$budget" -gt 0 ] 2>/dev/null && [ $((calls * 5)) -ge $((budget * 4)) ] && mark="!"
    printf '%-16s %-11s %-9s %-8s %-9s %-8s %-5s %-6s %s\n' "$name" "$role" "$id" "$state" "$hs" "$calls/$budget$mark" "$tcalls" "${ctx:--}" "${last:--}"
  done
  [ -f "$d/cancelled.json" ] && jq -r '.[] | "cancelled: \(.taskId) — \(.note)"' "$d/cancelled.json"
  local t h cur
  [ ! -f "$d/accepted.json" ] || jq -r '.[] | select((.head // "") != "") | "\(.taskId) \(.head)"' "$d/accepted.json" | while read -r t h; do
    cur=$(git -C "$(repo_root)" rev-parse -q --verify "refs/heads/$(basename "$(task_worktree "$d" "$(jq -r --arg id "$t" '.tasks[] | select(.id == $id) | .name' "$d/plan.json")")")^{commit}" 2>/dev/null) || continue
    [ "$cur" = "$h" ] || echo "moved since accept: $t — its branch was at $h, now $cur; read what changed before it is merged"
  done
  [ -f "$d/PAUSE" ] && echo "RUN PAUSED: $(cat "$d/PAUSE")"
  local p; for p in "$d"/PAUSE-*; do [ -f "$p" ] && echo "PAUSED ${p##*/PAUSE-}: $(cat "$p")"; done
  [ "${3:-}" = --no-ready ] || echo "ready to spawn: $(cmd_ready "$(jq -r '.run' "$d/plan.json")" | tr '\n' ' ')"
}

cmd_events() {
  local d; d=$(run_dir "${1:-}"); shift; local since="" new=0 blocks=0 n
  while [ $# -gt 0 ]; do
    case "$1" in
      --since) since="${2:-0}"; shift 2 ;;
      --new) new=1; shift ;;
      --blocks) blocks=1; shift ;;
      *) die "unknown option $1; events <run> [--since <line>|--new] [--blocks]" ;;
    esac
  done
  [ "$new" = 0 ] || [ -z "$since" ] || die "--since and --new do not go together"
  [ "$new" = 0 ] || since=$(cat "$d/events.cursor" 2>/dev/null || echo 0)
  # Counted before printing: a line the guard appends meanwhile is left for the next --new.
  n=$(wc -l < "$d/events.log" | tr -d ' ')
  awk -F'|' -v s="${since:-0}" -v n="$n" -v b="$blocks" 'NR > s && NR <= n && (b == 0 || $5 == "block")' "$d/events.log"
  [ "$new" = 0 ] || echo "$n" > "$d/events.cursor"
}

# live_agents: claude agents --json --all, or nothing when it cannot be read.
live_agents() { command -v claude >/dev/null 2>&1 && claude agents --json --all 2>/dev/null; }

# run_rows <live_agents output>: a tab-separated row per run in the repo — name, state, open tasks, sessions
# (forgotten ones included) that claude agents lists, "?" when it could not be read, and the last event.
run_rows() {
  local p d state open live last
  for p in "$(repo_root)"/.orchestrator/*/plan.json; do
    [ -f "$p" ] || continue
    d=$(dirname "$p")
    if [ -f "$d/CLOSED" ]; then state=closed; elif [ -f "$d/PAUSE" ]; then state=paused; else state=open; fi
    open=$(open_tasks "$d" | grep -c .)
    live="?"
    [ -z "$1" ] || live=$(cat "$d/sessions.json" "$d/forgotten.json" 2>/dev/null \
      | jq -s -r --argjson a "$1" '[add // [] | .[] | select(.id as $i | $a | map(.id) | index($i))] | length' 2>/dev/null) || live="?"
    last=$(sed -n '$p' "$d/events.log" 2>/dev/null | cut -d'|' -f1,3-6 | cut -c1-70)
    printf '%s\t%s\t%s\t%s\t%s\n' "${d##*/}" "$state" "$open" "${live:-?}" "${last:--}"
  done
}

# cross_run_overlap <run_dir> <tasks json>: a warning per task that shares paths or resources with a live
# session of another unclosed run; the plan's own overlap check sees one run only. Live is read from the run
# files — not removed, and its task still open — since polling claude agents at spawn cost minutes under load.
cross_run_overlap() {
  local p o
  for p in "$(repo_root)"/.orchestrator/*/sessions.json; do
    o=${p%/sessions.json}
    [ "$o" != "$1" ] && [ ! -f "$o/CLOSED" ] && [ -f "$o/plan.json" ] || continue
    jq -r --argjson t "$2" --arg open "$(open_tasks "$o")" --slurpfile op "$o/plan.json" --arg r "${o##*/}" "$JQ_DEFS"'
      .[] | select((.removedAt // "") == "" and .role != "integrator") | . as $s
      | select($open | split("\n") | index($s.taskId))
      | [ $op[0].tasks[] | select(.id == $s.taskId) | .resources[]? ] as $sr
      | $t[] | select(.role != "integrator")
      | [ ((.pathsAllowed // [])[] as $x | ($s.pathsAllowed // [])[] as $y | select(paths_meet($x; $y)) | if $x == $y then $x else "\($x) ~ \($y)" end),
          (.resources[]? as $x | select(any($sr[]; . == $x)) | $x) ] as $sh
      | select(($sh | length) > 0)
      | "orch: warning: task \(.id) shares \($sh | join(", ")) with \($s.name), a live session of run \($r): both may write those files or use that resource at once — sequence them, split the paths, or orch decide in both runs who holds what"' "$p" >&2
  done
}

cmd_runs() {
  local run state open live last
  printf '%-20s %-7s %-5s %-5s %s\n' RUN STATE OPEN LIVE LAST_EVENT
  run_rows "$(live_agents)" | while IFS="$(printf '\t')" read -r run state open live last; do
    printf '%-20s %-7s %-5s %-5s %s\n' "$run" "$state" "$open" "$live" "$last"
  done
}

# cmd_graph: every task, spawned or not, with its state; an unspawned task that is not ready says why,
# checking what cmd_ready checks. A dependency that is cancelled and was never done keeps it out for good.
cmd_graph() {
  local d; d=$(run_dir "${1:-}")
  local id name role stage state why sess spawned dep dh orphan wait g a
  printf '%-12s %-16s %-15s %-10s %-6s %-20s %s\n' ID NAME ROLE STATE CALLS SESSIONS WHY
  jq -r '.tasks[] | [.id, .name, .role, (.stage // "")] | @tsv' "$d/plan.json" | while IFS="$(printf '\t')" read -r id name role stage; do
    why=""
    sess=$(cat "$d/sessions.json" "$d/forgotten.json" 2>/dev/null | jq -s -r --arg t "$id" '[add // [] | .[] | select(.taskId == $t) | .name] | join(",")')
    spawned=$(jq -r --arg id "$id" 'map(select(.taskId == $id)) | length' "$d/sessions.json")
    state=$(handoff_state "$d" "$name" "$id")
    case "$state" in
      cancelled) why=$(jq -r --arg id "$id" 'first(.[] | select(.taskId == $id) | .note) // ""' "$d/cancelled.json") ;;
      accepted|settled) ;;
      *)
        if [ "$spawned" -gt 0 ]; then
          [ "$state" = none ] && state=spawned
        else
          orphan=""; wait=""
          for dep in $(jq -r --arg id "$id" '.tasks[] | select(.id == $id) | .dependsOn[]' "$d/plan.json"); do
            task_done "$d" "$dep" "$role" && continue
            if is_cancelled "$d" "$dep"; then orphan="$orphan $dep"; continue; fi
            dh=$(handoff_state "$d" "$(jq -r --arg id "$dep" '.tasks[] | select(.id == $id) | .name' "$d/plan.json")" "$dep")
            [ "$dh" = done ] && dh="done, not accepted"
            wait="$wait, $dep ($dh)"
          done
          g=$(stage_gate "$d" "$stage"); a=$(arch_gate "$d" "$role")
          if [ -n "$orphan" ]; then state=orphaned; why="dependency cancelled:$orphan — never ready until re-planned (orch task set ${1} $id dependsOn …)"
          elif [ -n "$g" ]; then state=held; why="stage $stage waits for the user's approval of stage $g"
          elif [ -n "$a" ]; then state=held; why="waits for the architect task $a to be accepted"
          elif [ -n "$wait" ]; then state=waiting; why="on ${wait#, }"
          else state=ready; fi
        fi ;;
    esac
    printf '%-12s %-16s %-15s %-10s %-6s %-20s %s\n' "$id" "$name" "$role" "$state" "$(task_calls "$d" "$id")" "${sess:--}" "${why:--}"
  done
}

# cmd_inbox: what needs the lead now, in one call instead of status, events and a handoff per session.
# Blocks are shown once: the cursor in inbox.cursor is the events.log line the last inbox read up to.
cmd_inbox() {
  local d; d=$(run_dir "${1:-}")
  local out id name hs sid budget calls key st since n agents
  out=$(
    jq -r '.tasks[] | [.id, .name] | @tsv' "$d/plan.json" | while IFS="$(printf '\t')" read -r id name; do
      hs=$(handoff_state "$d" "$name" "$id")
      # The leading paren keeps bash 3.2 from ending the $( ) at the pattern's.
      case "$hs" in (done|partial|blocked|failed) echo "handoff $hs: $id ($name) — orch handoff ${1} $name" ;; esac
    done
    jq -r '.[] | select((.removedAt // "") == "") | [.name, .id, (if (.sessionId // "") == "" then "-" else .sessionId end), (.budget | tostring)] | @tsv' "$d/sessions.json" \
      | while IFS="$(printf '\t')" read -r name id sid budget; do
        if [ "$sid" = - ]; then key="${id}[^|]*"; else key="$sid"; fi
        calls=$(grep -c "^[^|]*|$key|[^|]*|[^|]*|allow|" "$d/events.log" 2>/dev/null || true); calls=${calls:-0}
        [ "$budget" -gt 0 ] 2>/dev/null && [ $((calls * 5)) -ge $((budget * 4)) ] && echo "budget: $name $calls/$budget — orch budget ${1} $name +<n>, or let it hand off"
      done
    since=$(cat "$d/inbox.cursor" 2>/dev/null || echo 0)
    # Counted before printing: a line the guard appends meanwhile is left for the next inbox.
    n=$(wc -l < "$d/events.log" | tr -d ' ')
    awk -v s="$since" -v n="$n" -F'|' 'NR > s && NR <= n && $5 == "block" { print "block: " $0 }' "$d/events.log"
    echo "$n" > "$d/inbox.cursor"
    # claude agents shows a session between turns as done (or blocked on a prompt); without a handoff it has not reported.
    if agents=$(live_agents); then
      jq -r --argjson a "$agents" '.[] | select((.removedAt // "") == "") | .id as $i
          | (first($a[] | select(.id == $i) | .state) // "") as $s | select($s != "" and $s != "working") | "\(.name)\t\($s)"' "$d/sessions.json" \
        | while IFS="$(printf '\t')" read -r name st; do
          [ -f "$(latest_handoff "$d" "$name")" ] || echo "idle without a handoff: $name (claude agents: $st) — message it"
        done
    else
      echo "idle sessions unknown: claude agents could not be read"
    fi
    n=$(cmd_ready "${1}" | tr '\n' ' '); n=${n% }
    [ -z "$n" ] || echo "ready: $n"
  )
  if [ -n "$out" ]; then printf '%s\n' "$out"; else echo "nothing needs you in run ${1}"; fi
}

# cmd_followups: every line under "## Follow-ups" in the run's handoffs, named by the session that wrote it —
# work outside a session's paths, which nobody owns until the lead routes it.
cmd_followups() {
  local d; d=$(run_dir "${1:-}"); local h line n=0
  for h in "$d"/handoffs/*.md; do
    [ -f "$h" ] || continue
    while IFS= read -r line; do
      printf '%s: %s\n' "$(basename "$h" .md)" "$line"; n=$((n + 1))
    done < <(section "$h" Follow-ups | sed -n 's/^[-*] *//; /[^[:space:]]/p')
  done
  [ "$n" -gt 0 ] || echo "no follow-ups in the handoffs of run $1"
}

cmd_handoff() {
  local d; d=$(run_dir "${1:-}"); local n="${2:-}" f o r others=""
  [ -n "$n" ] || die "handoff <run> <name>"
  plain_name "$n" || die "handoff: '$n' must be a plain name, a task or session name, not a path"
  f=$(latest_handoff "$d" "$n")
  [ -f "$f" ] || die "no handoff yet from $n"
  for o in "$d/handoffs/$n.md" "$d/handoffs/$n"-r*.md; do
    r=${o#"$d/handoffs/$n"}; r=${r#-r}; r=${r%.md}
    case "$r" in *[!0-9]*) continue ;; esac
    [ -f "$o" ] && [ "$o" != "$f" ] && others="$others ${o##*/}"
  done
  [ -z "$others" ] || echo "latest round: ${f##*/}; earlier rounds:$others — in $d/handoffs" >&2
  cat "$f"
}

# cmd_budget: the guard reads a live session's budget from sessions.json, not from the plan,
# so a mid-run change has to land in both.
cmd_budget() {
  local d; d=$(run_dir "${1:-}"); local who="${2:-}" n="${3:-}"
  [ -n "$who" ] || die "budget <run> <task-id|name> <n|+n>"
  local add=0 k="$n"
  case "$n" in +*) add=1; k="${n#+}" ;; esac
  case "$k" in ''|*[!0-9]*) die "budget <run> <task-id|name> <n|+n>  (n is a number of guarded tool calls, +n adds to the current budget)" ;; esac
  local hits
  hits=$(jq -r --arg w "$who" '[.tasks[] | select(.id == $w or .name == $w)] | length' "$d/plan.json")
  hits=$((hits + $(jq -r --arg w "$who" '[.[] | select(.taskId == $w or .name == $w)] | length' "$d/sessions.json")))
  [ "$hits" -gt 0 ] || die "no task or session '$who' in run ${1:-}"
  local set="rebudget(if \$add == 1 then (.budget // 0) + \$k else \$k end)"
  jq --arg w "$who" --argjson k "$k" --argjson add "$add" "$JQ_DEFS"'.tasks |= map(if .id == $w or .name == $w then '"$set"' else . end)' "$d/plan.json" > "$d/plan.tmp" && mv "$d/plan.tmp" "$d/plan.json"
  lock_run "$d"
  jq --arg w "$who" --argjson k "$k" --argjson add "$add" "$JQ_DEFS"'map(if .taskId == $w or .name == $w then '"$set"' else . end)' "$d/sessions.json" > "$d/sessions.json.tmp" && mv "$d/sessions.json.tmp" "$d/sessions.json"
  unlock_run "$d"
  ev "$d" orchestrator "$who" budget allow "$n"
  local now_b
  now_b=$(jq -r --arg w "$who" --slurpfile s "$d/sessions.json" '[(.tasks[] | select(.id == $w or .name == $w) | "task \(.id) \(.budget)"),
    ($s[0][] | select((.taskId == $w or .name == $w) and (.removedAt // "") == "") | "session \(.name) \(.budget)")] | join(", ")' "$d/plan.json")
  echo "budget of $who: $n guarded calls, now $now_b — the guard honours it from the session's next call"
}

cmd_pause() {
  local d; d=$(run_dir "${1:-}"); local who="${2:-}" reason="${3:-paused by the orchestrator}"
  [ -n "$who" ] || die "pause <run> <name|all> \"<reason>\""
  if [ "$who" = all ]; then printf '%s\n' "$reason" > "$d/PAUSE"; else
    jq -e --arg n "$who" 'map(select(.name == $n)) | length > 0' "$d/sessions.json" >/dev/null || jq -e --arg n "$who" '.tasks | map(select(.name == $n)) | length > 0' "$d/plan.json" >/dev/null || die "no session or task named '$who'"
    printf '%s\n' "$reason" > "$d/PAUSE-$who"
  fi
  ev "$d" orchestrator "$who" pause "$who" "$reason"
  echo "paused $who: $reason — now message the session what to do instead"
}

cmd_resume() {
  local d; d=$(run_dir "${1:-}"); local who="${2:-}"
  [ -n "$who" ] || die "resume <run> <name|all>"
  if [ "$who" = all ]; then rm -f "$d/PAUSE"; else rm -f "$d/PAUSE-$who"; fi
  ev "$d" orchestrator "$who" resume "$who" ""
  echo "resumed $who"
}

# resume_brief <run>: the run's state for a lead that starts again — after a freeze, a restart or a
# compaction — read from the run's files and git, never from the lead's memory.
resume_brief() {
  local d; d=$(run_dir "$1")
  local root base name b h f id r
  root=$(repo_root); base=$(jq -r '.baseBranch' "$d/plan.json")
  printf '# Resume brief: run %s, %s\n\n' "$1" "$(now)"
  [ ! -f "$d/PAUSE" ] || printf 'paused: %s\n' "$(cat "$d/PAUSE")"
  printf 'base: %s at %s\norchestrator: %s\n' "$base" "$(git -C "$root" rev-parse -q --verify "refs/heads/$base^{commit}" 2>/dev/null || echo 'no such branch here')" "$(jq -r '.orchestrator // "-"' "$d/plan.json")"
  printf '\n## Tasks\n'; cmd_graph "$1"
  printf '\n## Branches\n'
  for name in $(jq -r '.tasks[].name' "$d/plan.json"); do
    b=$(basename "$(task_worktree "$d" "$name")")
    h=$(git -C "$root" rev-parse -q --verify "refs/heads/$b^{commit}" 2>/dev/null) && echo "$name: $b at $h"
  done
  [ ! -f "$d/lead-branches" ] || while read -r b; do
    echo "lead: $b at $(git -C "$root" rev-parse -q --verify "refs/heads/$b^{commit}" 2>/dev/null || echo 'no such branch here')"
  done < "$d/lead-branches"
  printf '\n## Latest handoffs\n'
  for name in $(jq -r '.tasks[].name' "$d/plan.json"); do
    f=$(latest_handoff "$d" "$name")
    [ -f "$f" ] && echo "$(basename "$f" .md): $(awk '/^## Status/ {s=1; next} s && NF {print; exit}' "$f")"
  done
  printf '\n## Sessions\n'
  jq -r '.[] | "\(.name) (\(.id))" + (if (.removedAt // "") == "" then "" else ", removed" end)' "$d/sessions.json"
  printf '\n## Authorizations\n'
  jq -r '.authorize // {} | to_entries[] | select(.value == true) | .key | gsub("(?<c>[A-Z])"; "-" + (.c | ascii_downcase))' "$d/plan.json"
  printf '\n## Decisions, the last 10\n'
  if [ -f "$d/decisions.md" ]; then tail -n 10 "$d/decisions.md"; else echo "(none)"; fi
  printf '\n## Next commands\n'
  [ ! -f "$d/PAUSE" ] || echo "orch thaw $1 — forgets the sessions this machine does not run, drops the PAUSE files, prints what is ready"
  echo "orch inbox $1 — what needs you now"
  for id in $(open_tasks "$d"); do
    [ "$(jq -r --arg id "$id" '.tasks[] | select(.id == $id) | .role' "$d/plan.json")" = developer ] || continue
    name=$(jq -r --arg id "$id" '.tasks[] | select(.id == $id) | .name' "$d/plan.json")
    cat "$d/sessions.json" "$d/forgotten.json" 2>/dev/null | jq -s -e --arg id "$id" 'add | map(select(.taskId == $id)) | length > 0' >/dev/null || continue
    case "$(handoff_state "$d" "$name" "$id")" in
      none|partial) echo "orch continue $1 $name — its last session stopped before done; the next one finishes from git status" ;;
    esac
  done
  r=$(cmd_ready "$1" | tr '\n' ' '); r=${r% }
  [ -z "$r" ] || echo "orch spawn $1 --wave — ready: $r"
}

cmd_resume_brief() { [ -n "${1:-}" ] || die "resume-brief <run>"; resume_brief "$1"; }

# cmd_freeze: stop the whole run so it can go on later or on another machine; RESUME.md keeps its state.
cmd_freeze() {
  local d; d=$(run_dir "${1:-}"); local why="${2:-}"
  [ -n "$why" ] || die "freeze <run> \"<why>\""
  need claude
  cmd_pause "$1" all "frozen: $why" > /dev/null
  resume_brief "$1" > "$d/RESUME.md"
  cmd_stop "$1" all
  ev "$d" orchestrator "$1" freeze allow "$why"
  echo "frozen: $d/RESUME.md holds the run's state; to go on, here or on another machine: orch thaw $1"
}

cmd_thaw() {
  local d; d=$(run_dir "${1:-}"); local r
  # On another machine claude agents may list no session at all, which forget --dead refuses to read as all dead.
  ( cmd_forget "$1" --dead ) || echo "orch: no session forgotten; orch forget $1 <name> for each one this machine does not run" >&2
  rm -f "$d/PAUSE" "$d"/PAUSE-*
  ev "$d" orchestrator "$1" thaw allow ""
  r=$(cmd_ready "$1" | tr '\n' ' '); r=${r% }
  echo "ready: ${r:-(none)}"
}

cmd_decide() {
  local d; d=$(run_dir "${1:-}"); [ -n "${2:-}" ] || die "decide <run> \"<decision>\" [--for <task-id|name>]..."
  local run="$1" text="$2" ids="" id t for=""; shift 2
  while [ $# -gt 0 ]; do
    [ "$1" = --for ] && [ -n "${2:-}" ] || die "decide <run> \"<decision>\" [--for <task-id|name>]..."
    id=$(resolve_task "$d" "$2") || die "no task or session '$2' in plan"
    ids="$ids $id"; for="${for:+$for, }$id"; shift 2
  done
  printf -- '- %s — %s%s\n' "$(now)" "$text" "${for:+ (for $for)}" >> "$d/decisions.md"
  [ -n "$ids" ] || ev "$d" orchestrator "$run" decide allow "$text"
  for t in $ids; do ev "$d" orchestrator "$t" decide allow "$text"; done
  echo "recorded in $d/decisions.md — now message the parties"
}

# cmd_lead_branch: a branch the lead made itself is in no session record or handoff, so close would never check it.
cmd_lead_branch() {
  local d; d=$(run_dir "${1:-}"); local b="${2:-}"
  [ -n "$b" ] || die "lead-branch <run> <branch>"
  [ "$b" != "$(jq -r '.baseBranch' "$d/plan.json")" ] || die "$b is the base branch; register a branch whose work goes into it"
  git -C "$(repo_root)" rev-parse -q --verify "refs/heads/$b" >/dev/null 2>&1 || die "no branch $b in this repository"
  grep -qxF -- "$b" "$d/lead-branches" 2>/dev/null || printf '%s\n' "$b" >> "$d/lead-branches"
  ev "$d" orchestrator "${1:-}" lead-branch allow "$b"
  echo "lead branch $b registered: orch close checks it is contained in the base"
}

# cmd_task: add or change tasks through the same validation as orch plan, on the stored plan, so an
# edit never starts from a stale or rejected copy.
cmd_task() {
  local sub="${1:-}" run="${2:-}"
  [ $# -ge 2 ] || die "task add <run> <file|-> | task set <run> <task-id|name> <field> <json> | task patch <run> <file>"
  shift 2
  local d; d=$(run_dir "$run"); local tmp="$d/plan.edit.json" id="" field=""
  case "$sub" in
    add)
      local src="${1:-}" new
      [ -n "$src" ] || die "task add <run> <file|->  (a task object or an array of them)"
      if [ "$src" = - ]; then new=$(cat); else [ -f "$src" ] || die "no such file $src"; new=$(cat "$src"); fi
      jq . >/dev/null 2>&1 <<<"$new" || die "task add: not valid JSON"
      jq --argjson n "$new" '.tasks += (if ($n | type) == "array" then $n else [$n] end)' "$d/plan.json" > "$tmp"
      ;;
    set)
      [ $# -ge 3 ] || die "task set <run> <task-id|name> <field> <json value>"
      id=$(resolve_task "$d" "$1") || die "no task or session '$1' in run $run"
      field="$2"
      jq . >/dev/null 2>&1 <<<"$3" || die "task set: the value must be JSON — 7, \"text\", [\"a\",\"b\"]"
      jq --arg id "$id" --arg f "$field" --argjson v "$3" '.tasks |= map(if .id == $id then .[$f] = $v else . end)' "$d/plan.json" > "$tmp"
      ;;
    patch)
      local src="${1:-}" p k t ids='{}'
      [ -n "$src" ] || die "task patch <run> <file>  ({\"<task-id|name>\": {\"<field>\": <json value>}, …})"
      [ -f "$src" ] || die "no such file $src"
      p=$(jq -c . "$src" 2>/dev/null) || die "task patch: $src is not valid JSON"
      jq -e 'type == "object" and all(.[]; type == "object")' >/dev/null <<<"$p" || die "task patch: $src must be {\"<task-id|name>\": {\"<field>\": <json value>}, …}"
      while IFS= read -r k; do
        t=$(resolve_task "$d" "$k") || die "no task or session '$k' in run $run"
        ids=$(jq -c --arg k "$k" --arg t "$t" '. + {($k): $t}' <<<"$ids")
      done < <(jq -r 'keys[]' <<<"$p")
      jq --argjson p "$p" --argjson ids "$ids" '.tasks |= map(. as $t | reduce ($p | to_entries[] | select($ids[.key] == $t.id) | .value) as $f ($t; . + $f))' "$d/plan.json" > "$tmp"
      ;;
    *) die "task add <run> <file|-> | task set <run> <task-id|name> <field> <json> | task patch <run> <file>" ;;
  esac
  ( cmd_plan "$run" "$tmp" --replan ) || { rm -f "$tmp"; exit 1; }
  rm -f "$tmp"
  if [ "$sub" = patch ]; then
    # Budgets and pathsAllowed reached the live sessions through the replan.
    jq -r --argjson ids "$ids" 'to_entries | map({id: $ids[.key], f: (.value | keys)}) | group_by(.id)[] | "\(.[0].id)\t\([.[].f[]] | unique | join(","))"' <<<"$p" | while IFS="$(printf '\t')" read -r t k; do
      ev "$d" orchestrator "$t" task-patch allow "$k"
      echo "patched $t: $k"
    done
    return 0
  fi
  case "$field" in
    budget|pathsAllowed)
      lock_run "$d"
      jq --arg id "$id" --arg f "$field" --argjson v "$3" 'map(if .taskId == $id then .[$f] = $v else . end)' "$d/sessions.json" > "$d/sessions.json.tmp" && mv "$d/sessions.json.tmp" "$d/sessions.json"
      unlock_run "$d"
      echo "live sessions of $id carry the new $field" ;;
  esac
  ev "$d" orchestrator "${id:-new}" "task-$sub" allow "$field"
}

cmd_paths() {
  local d; d=$(run_dir "${1:-}"); local who="${2:-}" op="${3:-}"
  [ "$op" = add ] && [ $# -ge 4 ] || die "paths <run> <task-id|name> add <glob>..."
  local id; id=$(resolve_task "$d" "$who") || die "no task or session '$who' in run ${1:-}"
  shift 3
  local globs; globs=$(printf '%s\n' "$@" | jq -R . | jq -sc .)
  jq --arg id "$id" --argjson g "$globs" '.tasks |= map(if .id == $id then (.pathsAllowed // []) as $p | .pathsAllowed = $p + ($g - $p) else . end)' "$d/plan.json" > "$d/plan.tmp" && mv "$d/plan.tmp" "$d/plan.json"
  lock_run "$d"
  jq --arg id "$id" --argjson g "$globs" 'map(if .taskId == $id then (.pathsAllowed // []) as $p | .pathsAllowed = $p + ($g - $p) else . end)' "$d/sessions.json" > "$d/sessions.json.tmp" && mv "$d/sessions.json.tmp" "$d/sessions.json"
  unlock_run "$d"
  ev "$d" orchestrator "$id" paths allow "$*"
  echo "paths of $id now: $(jq -r --arg id "$id" '.tasks[] | select(.id == $id) | .pathsAllowed | join(", ")' "$d/plan.json") — the guard honours them from the session's next call"
}

cmd_cancel() {
  local d; d=$(run_dir "${1:-}"); local who="${2:-}" note="${3:-}"
  [ -n "$who" ] || die "cancel <run> <task-id|name> \"<why>\" | --undo"
  local id; id=$(resolve_task "$d" "$who") || die "no task or session '$who' in run ${1:-}"
  [ -f "$d/cancelled.json" ] || echo '[]' > "$d/cancelled.json"
  if [ "$note" = --undo ]; then
    jq --arg id "$id" 'map(select(.taskId != $id))' "$d/cancelled.json" > "$d/cancelled.tmp" && mv "$d/cancelled.tmp" "$d/cancelled.json"
    ev "$d" orchestrator "$id" uncancel allow ""
    echo "$id is back in the run"; return 0
  fi
  [ -n "$note" ] || die "cancel needs a reason: orch cancel <run> $who \"<why>\""
  jq --arg id "$id" --arg note "$note" --arg t "$(now)" 'map(select(.taskId != $id)) + [{taskId:$id, at:$t, note:$note}]' "$d/cancelled.json" > "$d/cancelled.tmp" && mv "$d/cancelled.tmp" "$d/cancelled.json"
  ev "$d" orchestrator "$id" cancel allow "$note"
  echo "cancelled $id: $note — never ready, settled for close; its dependents stay blocked until you re-plan them (orch task set <id> dependsOn …)"
}

# cmd_forget: a run moved to another machine keeps the records of sessions that machine does not
# run, and orch ready never offers a task that has one. Handoffs, worktrees and branches stay. A
# forgotten session goes to forgotten.json, where the guard still finds it and refuses its every
# call: forgetting a session that is still alive holds it rather than setting it free.
cmd_forget() {
  local d; d=$(run_dir "${1:-}"); local who="${2:-}" gone
  [ -n "$who" ] || die "forget <run> <name|--dead>"
  if [ "$who" = --dead ]; then
    need claude
    local live; live=$(claude agents --json --all 2>/dev/null) || die "claude agents --json failed; nothing forgotten"
    [ "$(jq 'length' <<<"$live" 2>/dev/null || echo 0)" -gt 0 ] || die "claude agents lists no session on this machine, which proves nothing; forget sessions by name"
    # A session orch removed with claude rm is not listed either, and its task is finished.
    gone=$(jq -c --argjson a "$live" '[.[] | select((.removedAt // "") == "") | select(.id as $i | ($a | map(.id) | index($i)) == null)]' "$d/sessions.json")
  else
    gone=$(jq -c --arg n "$who" '[.[] | select(.name == $n)]' "$d/sessions.json")
    [ "$(jq 'length' <<<"$gone")" -gt 0 ] || die "no session named '$who' in run ${1:-}"
  fi
  [ "$(jq 'length' <<<"$gone")" -gt 0 ] || { echo "every session of run ${1:-} runs on this machine"; return 0; }
  lock_run "$d"
  [ -f "$d/forgotten.json" ] || echo '[]' > "$d/forgotten.json"
  jq --argjson g "$gone" '. + $g' "$d/forgotten.json" > "$d/forgotten.tmp" && mv "$d/forgotten.tmp" "$d/forgotten.json"
  jq --argjson g "$gone" '[.[] | select(.name as $n | ($g | map(.name) | index($n)) == null)]' "$d/sessions.json" > "$d/sessions.json.tmp" && mv "$d/sessions.json.tmp" "$d/sessions.json"
  unlock_run "$d"
  ev "$d" orchestrator "$who" forget allow "$(jq -r 'map(.name) | join(" ")' <<<"$gone")"
  echo "forgot $(jq -r 'map(.name) | join(", ")' <<<"$gone") — their tasks can be spawned again; handoffs, worktrees and branches stay"
}

cmd_stop() {
  local d; d=$(run_dir "${1:-}"); local who="${2:-}" ids
  [ -n "$who" ] || die "stop <run> <name|all>"
  if [ "$who" = all ]; then
    ids=$(jq -r '.[] | select((.removedAt // "") == "") | .id' "$d/sessions.json")
  else
    jq -e --arg n "$who" 'map(select(.name == $n)) | length > 0' "$d/sessions.json" >/dev/null || die "no session named '$who' in run ${1:-}"
    ids=$(jq -r --arg n "$who" '.[] | select(.name == $n and (.removedAt // "") == "") | .id' "$d/sessions.json")
  fi
  need claude
  local id n=0
  for id in $ids; do
    claude stop "$id" >/dev/null 2>&1 || echo "note: claude stop $id failed; it may have stopped already" >&2
    n=$((n + 1))
  done
  ev "$d" orchestrator "$who" stop allow "$n sessions"
  echo "stopped $n session(s) — worktrees stay; each handoff's 'Left running' says what the session left behind"
}

# cost_row <name> <session id or its prefix>: one tab-separated row over every transcript file of the session
# (one per project directory its cwd was in, and its subagents'). A message is written as several lines that
# repeat its usage, so each message.id is counted once across them; a naive sum measured about twice the real figure.
cost_row() {
  local f files=()
  while IFS= read -r f; do files+=("$f"); done < <(find "$PROJECTS_DIR" -maxdepth 4 \( -name "$2*.jsonl" -o -path "*/$2*/subagents/*.jsonl" \) 2>/dev/null)
  if [ ${#files[@]} -eq 0 ]; then printf '%s\t-\n' "$1"; return; fi
  jq -s -r --arg n "$1" '[.[] | select(.type == "assistant" and .message.usage != null)]
    | group_by(.message.id // .uuid) | map(.[-1].message.usage)
    | [$n, (map(.output_tokens // 0) | add // 0), (map(.input_tokens // 0) | add // 0),
       (map(.cache_read_input_tokens // 0) | add // 0), (map(.cache_creation_input_tokens // 0) | add // 0)] | @tsv' "${files[@]}"
}

cmd_cost() {
  local d; d=$(run_dir "${1:-}")
  local row='$2 == "-" { printf "%-18s %10s\n", $1, "-"; next }
    { printf "%-18s %10d %10d %12d %12d\n", $1, $2, $3, $4, $5; o += $2; i += $3; r += $4; w += $5 }'
  printf '%-18s %10s %10s %12s %12s\n' NAME OUTPUT INPUT CACHE_READ CACHE_WRITE
  jq -r '.[] | [.name, (if (.sessionId // "") == "" then .id else .sessionId end)] | @tsv' "$d/sessions.json" | while IFS="$(printf '\t')" read -r name sid; do
    cost_row "$name" "$sid"
  done | awk -F'\t' "$row"'
    END { printf "%-18s %10d %10d %12d %12d\n", "TOTAL", o, i, r, w }'
  # Below the team's total: the lead's session can span more than this run.
  [ ! -s "$d/lead-session" ] || cost_row lead "$(cat "$d/lead-session")" | awk -F'\t' "$row"
}

cmd_approve() {
  local d; d=$(run_dir "${1:-}"); local stage="${2:-}" note="${3:-}"
  [ "$(jq -r '.mode // "single"' "$d/plan.json")" = staged ] || die "run ${1:-} is not staged; approve applies to mode staged"
  [ -n "$stage" ] || die "approve <run> <stage> \"<the user's words>\" | approve <run> --rest \"<the user's words>\""
  if [ "$stage" = --rest ]; then
    # The user lifts staging: one approval for every stage left, so from here only dependencies order the tasks.
    [ -n "$note" ] || die "approve --rest needs the user's words: orch approve ${1:-} --rest \"<what the user said>\""
    [ -f "$d/approved.json" ] || echo '[]' > "$d/approved.json"
    local rest
    rest=$(jq -r --slurpfile ap "$d/approved.json" '[(.stages // [])[] | select(. as $x | ($ap[0] | map(.stage) | index($x)) == null)] | join(" ")' "$d/plan.json")
    [ -n "$rest" ] || die "every stage of run ${1:-} is approved already"
    jq --arg rest "$rest" --arg note "$note" --arg t "$(now)" '. + [$rest | split(" ")[] | {stage:., at:$t, note:$note, rest:true}]' "$d/approved.json" > "$d/approved.tmp" && mv "$d/approved.tmp" "$d/approved.json"
    ev "$d" orchestrator rest approve allow "$note"
    echo "stages $rest approved at once — no stage waits for the user any more; orch ready shows what can start"
    return 0
  fi
  plain_name "$stage" || die "stage name '$stage' is not a plain name"
  jq -e --arg s "$stage" '(.stages // []) | index($s) != null' "$d/plan.json" >/dev/null || die "no stage '$stage'; stages: $(jq -r '.stages | join(", ")' "$d/plan.json")"
  local gate; gate=$(stage_gate "$d" "$stage")
  [ -z "$gate" ] || die "stage $gate comes first and is not approved yet"
  local open; open=$(open_tasks "$d" "$stage" | tr '\n' ' ') || die "could not work out which tasks are accepted"
  [ -z "$open" ] || die "stage $stage has tasks not accepted: ${open}- accept or cancel them first"
  [ -n "$note" ] || die "approve needs the user's words: orch approve ${1:-} $stage \"<what the user said>\""
  jq --arg s "$stage" --arg note "$note" --arg t "$(now)" 'map(select(.stage != $s)) + [{stage:$s, at:$t, note:$note}]' "$d/approved.json" > "$d/approved.tmp" && mv "$d/approved.tmp" "$d/approved.json"
  ev "$d" orchestrator "$stage" approve allow "$note"
  echo "stage $stage approved — orch ready shows what the next stage starts with"
}

html_esc() { printf '%s' "$1" | jq -Rrs @html; }
# section <file> <heading>: the lines under "## <heading>" up to the next "## ".
section() { awk -v h="$2" '$0 == "## " h {f=1; next} /^## / && f {exit} f' "$1"; }

# cmd_stage_report: one self-contained page per stage for the user's approval: every task's state,
# status, branch and what it did, with the images its handoff names — only those inside the repository.
cmd_stage_report() {
  local d; d=$(run_dir "${1:-}"); local stage="${2:-}"
  [ -n "$stage" ] || die "stage-report <run> <stage>"
  plain_name "$stage" || die "stage name '$stage' is not a plain name"
  jq -e --arg s "$stage" '[.tasks[] | select(.stage == $s)] | length > 0' "$d/plan.json" >/dev/null || die "no task in stage '$stage'"
  local root out img
  root=$(cd "$(repo_root)" && pwd -P); out="$d/stages/$stage"; img="$out/img"
  rm -rf "$out"; mkdir -p "$img"
  local cards="" id name role hs h p f rf wt pics n=0 miss=0
  for id in $(jq -r --arg s "$stage" '.tasks[] | select(.stage == $s) | .id' "$d/plan.json"); do
    name=$(jq -r --arg id "$id" '.tasks[] | select(.id == $id) | .name' "$d/plan.json")
    role=$(jq -r --arg id "$id" '.tasks[] | select(.id == $id) | .role' "$d/plan.json")
    hs=$(handoff_state "$d" "$name" "$id"); h=$(latest_handoff "$d" "$name"); pics=""
    if [ -f "$h" ]; then
      # The session record's worktree, not claude agents: accept has usually removed the session by now.
      wt=$(cat "$d/sessions.json" "$d/forgotten.json" 2>/dev/null | jq -rs --arg n "$(basename "$h" .md)" 'first(add[] | select(.name == $n) | .worktree) // empty')
      for p in $(grep -oE '[^][:space:]()`"<>'"'"'[]+\.(png|jpe?g|gif|webp)' "$h" | sort -u); do
        case "$p" in /*) f="$p" ;; *) [ -n "$wt" ] || { miss=$((miss + 1)); continue; }; f="$wt/$p" ;; esac
        [ -f "$f" ] || { miss=$((miss + 1)); continue; }
        [ ! -L "$f" ] || continue
        # A hard link inside the repository can name a file outside it; one link means it is the file itself.
        [ "$(ls -ln "$f" | awk '{print $2}')" = 1 ] || continue
        rf="$(cd "$(dirname "$f")" 2>/dev/null && pwd -P)/$(basename "$f")"
        case "$rf" in "$root"/*) ;; *) continue ;; esac
        cp "$rf" "$img/$name-$(basename "$rf")" && n=$((n + 1))
        pics="$pics<img src=\"img/$(html_esc "$name-$(basename "$rf")")\" alt=\"$(html_esc "$(basename "$rf")")\">"
      done
    fi
    cards="$cards<section class=\"card\"><h2>$(html_esc "$name") <span class=\"role\">$(html_esc "$role")</span></h2><p class=\"state\">$(html_esc "$hs")</p>"
    if [ -f "$h" ]; then
      cards="$cards<h3>Status</h3><pre>$(html_esc "$(section "$h" Status)")</pre><h3>Branch</h3><pre>$(html_esc "$(section "$h" Branch)")</pre><h3>What I did</h3><pre>$(html_esc "$(section "$h" "What I did")")</pre>"
    else
      cards="$cards<p>No handoff yet.</p>"
    fi
    [ -n "$pics" ] && cards="$cards<h3>Evidence</h3><div class=\"pics\">$pics</div>"
    cards="$cards</section>"
  done
  cat > "$out/index.html" <<EOF
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Stage $(html_esc "$stage") review</title>
<style>
:root{--bg:#fbfbfa;--fg:#1c1c1a;--muted:#5d5d58;--card:#ffffff;--line:#deded9}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--bg:#161615;--fg:#ececea;--muted:#a3a39e;--card:#1f1f1e;--line:#34342f}}
:root[data-theme="dark"]{--bg:#161615;--fg:#ececea;--muted:#a3a39e;--card:#1f1f1e;--line:#34342f}
body{margin:0;background:var(--bg);color:var(--fg);font:15px/1.5 system-ui,-apple-system,sans-serif}
main{max-width:960px;margin:0 auto;padding:24px 16px}
h1{font-size:22px;margin:0 0 4px}.meta{color:var(--muted);margin:0 0 16px}
.card{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:16px;margin:16px 0}
h2{font-size:17px;margin:0}.role{color:var(--muted);font-weight:400}.state{font-weight:600;margin:4px 0 8px}
h3{font-size:13px;color:var(--muted);margin:12px 0 4px;text-transform:uppercase;letter-spacing:.04em}
pre{white-space:pre-wrap;word-break:break-word;font:13px/1.45 ui-monospace,monospace;margin:0}
.pics{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px}
img{max-width:100%;height:auto;border:1px solid var(--line);border-radius:4px}
</style></head>
<body><main>
<h1>Stage $(html_esc "$stage")</h1>
<p class="meta">Run $(html_esc "${1:-}") · $(html_esc "$(now)") · the next stage starts after your approval</p>
$cards
</main></body></html>
EOF
  echo "$out/index.html"
  echo "$n image(s) copied into $img — publish the page with its img/ files, or open it locally"
  echo "$miss image reference(s) not found"
}

# arch_root: the working tree the map is read from — the worktree orch runs in, never the main
# checkout behind it: an architect's map lives on its own branch until the integrator merges it.
arch_root() { git rev-parse --show-toplevel 2>/dev/null || die "not inside a git repository"; }

# built_at <README text on stdin> <root>: the commit named by the map's built-at line, when it is a real one.
built_at() {
  local sha; sha=$(sed -n 's/^built-at: *\([0-9a-f]\{7,40\}\).*/\1/p' | sed -n 1p)
  [ -n "$sha" ] && git -C "$1" cat-file -e "$sha^{commit}" 2>/dev/null && git -C "$1" rev-parse "$sha"
}

arch_sha() {
  local r; r=$(arch_root)
  [ -f "$r/docs/architecture/README.md" ] || return 0
  built_at "$r" < "$r/docs/architecture/README.md"
}

# arch_status [ref]: the map in this worktree, or the map committed on <ref> (what a new worktree starts from).
arch_status() {
  local r text sha tip
  if [ -n "${1:-}" ]; then
    r=$(repo_root); tip="$1"
    text=$(git -C "$r" show "$1:docs/architecture/README.md" 2>/dev/null) || { printf 'none yet — build it (on %s)' "$1"; return; }
  else
    r=$(arch_root); tip=HEAD
    [ -f "$r/docs/architecture/README.md" ] || { printf 'none yet — build it'; return; }
    text=$(cat "$r/docs/architecture/README.md")
  fi
  sha=$(printf '%s\n' "$text" | built_at "$r")
  if [ -z "$sha" ]; then printf 'docs/architecture/README.md without a valid built-at commit — treat it as stale'; return; fi
  printf 'docs/architecture/README.md, built at %s, %s commits behind %s' "$(git -C "$r" rev-parse --short "$sha")" "$(git -C "$r" rev-list --count "$sha..$tip")" "$tip"
}

# Paths the map never describes: the map itself, its generated rules, worktrees nested in a checkout.
ARCH_OWN='["docs/architecture/**", ".claude/rules/architecture/**", ".claude/worktrees/**"]'

# arch_files <root>: every file of the working tree git would track — committed, staged or new, not deleted.
arch_files() {
  comm -23 <(git -C "$1" ls-files -co --exclude-standard | sort -u) <(git -C "$1" ls-files -d | sort -u)
}

# arch_schema <modules.json>: what is wrong with its shape, one line each.
arch_schema() {
  jq -r 'def bad(m): "FAIL modules.json: " + m;
    if (.modules | type) != "array" or (.modules | length) == 0 then bad("needs a non-empty modules list") else
      [ .modules[] | select((.name | type) != "string" or (.name | test("^[A-Za-z0-9][A-Za-z0-9._-]*$") | not) or (.name | test("[.][.]")))
        | bad("module name \(.name | tojson) must be letters, digits, dots, hyphens and underscores") ][]
      , ( [.modules[].name] | group_by(.) | map(select(length > 1) | bad("duplicate module \(.[0])")) | .[] )
      , [ .modules[] | select((.doc | type) != "string" or (.doc | test("^/|(^|/)[.][.](/|$)"))) | bad("module \(.name): doc must be a path inside docs/architecture/") ][]
      , [ .modules[] | select((.paths | type) != "array" or (.paths | length) == 0 or any(.paths[]; type != "string")) | bad("module \(.name): paths must be a non-empty list of globs") ][]
      , [ .modules[] | select((.summary | type) != "string" or (.summary | length) == 0) | bad("module \(.name): summary is required — it is what a session reads when it opens a file of the module") ][]
    end,
    (if has("ignore") and ((.ignore | type) != "array" or any(.ignore[]; type != "string")) then bad("ignore must be a list of globs") else empty end)' "$1" 2>/dev/null \
    || echo "FAIL modules.json is not valid JSON"
}

# rule_text (jq, on a module): the path-scoped rule Claude Code loads when a session reads one of its files.
JQ_RULE='def rule_text($marker): "---\npaths:\n" + ([.paths[] | "  - " + tojson] | join("\n")) + "\n---\n" + $marker
  + "\n\n# Architecture: " + .name + "\n\n" + .summary
  + "\n\nFull description: docs/architecture/" + .doc + " · map index: docs/architecture/README.md";'

# arch_check: the map in this worktree against the tree it describes. One line per problem; fails on any.
arch_check() {
  local r m sha files changed rules problems=0 out
  r=$(arch_root); m="$r/docs/architecture"
  [ -f "$m/README.md" ] || { echo "FAIL docs/architecture/README.md is missing — there is no map; build it"; return 1; }
  sha=$(built_at "$r" < "$m/README.md")
  [ -n "$sha" ] || { echo "FAIL README.md has no built-at line naming a commit of this repository"; problems=$((problems + 1)); }
  [ -f "$m/modules.json" ] || { echo "FAIL docs/architecture/modules.json is missing — list every module: name, doc, paths, summary"; return 1; }
  out=$(arch_schema "$m/modules.json")
  [ -z "$out" ] || { printf '%s\n' "$out"; return 1; }
  local doc
  for doc in $(jq -r '.modules[].doc' "$m/modules.json"); do
    [ -f "$m/$doc" ] || { echo "FAIL module doc docs/architecture/$doc is missing"; problems=$((problems + 1)); }
  done
  files=$(arch_files "$r" | jq -R . | jq -sc .)
  changed='[]'
  [ -z "$sha" ] || changed=$({ git -C "$r" diff --name-only "$sha"; git -C "$r" ls-files -o --exclude-standard; } | sort -u | jq -R . | jq -sc 'map(select(. != ""))')
  rules='{}'
  if [ -d "$r/.claude/rules/architecture" ]; then
    local f
    rules=$(for f in "$r/.claude/rules/architecture"/*.md; do [ -f "$f" ] && jq -Rs --arg n "$(basename "$f" .md)" '{($n): .}' "$f"; done | jq -s 'add // {}')
  fi
  out=$(jq -rn --slurpfile mj "$m/modules.json" --argjson files "$files" --argjson changed "$changed" --argjson rules "$rules" \
      --argjson own "$ARCH_OWN" --arg marker "$ARCH_MARKER" --arg key "$ARCH_MARK_KEY" --arg sha "${sha:0:7}" "$JQ_GLOB$JQ_RULE"'
    $mj[0] as $mj | ($mj.ignore // []) as $ign | [$mj.modules[].paths[]] as $all
    | ($files | map(select(matches_any($own) | not))) as $tree
    | def groups: group_by(dir_of) | map("\(.[0] | dir_of)/ (\(length) file\(if length > 1 then "s" else "" end))") | join(", ");
    ( [ $tree[] | select(matches_any($all) or matches_any($ign) | not) ]
      | select(length > 0) | "FAIL \(length) file(s) belong to no module and are not in ignore: \(groups) — add them to a module or to ignore" ),
    ( [ $mj.modules[] | .name as $n | .paths[] as $g | select([ $tree[] | select(test($g | glob_re)) ] | length == 0) | "\($n): \($g)" ]
      | select(length > 0) | "FAIL module paths that match no file: \(join(", "))" ),
    ( [ $changed[] | select(matches_any($own) or matches_any($ign) | not) ] as $c
      | select(($c | length) > 0)
      | ([ $mj.modules[] | . as $mod | select(any($c[]; matches_any($mod.paths))) | .name ] | unique) as $touched
      | "FAIL the map is behind: \($c | length) file(s) changed since built-at \($sha)"
        + (if ($touched | length) > 0 then " — modules: \($touched | join(", "))" else "" end)
        + (([ $c[] | select(matches_any($all) | not) ]) as $out | if ($out | length) > 0 then "; outside every module: \($out | groups)" else "" end)
        + ". Update those modules, commit the code first, and move built-at to that commit" ),
    ( [ $mj.modules[] | select(($rules[.name] // null) != (rule_text($marker) + "\n")) | .name ]
      | select(length > 0) | "FAIL generated rules missing or out of date for: \(join(", ")) — run orch architecture --sync" ),
    ( [ $rules | to_entries[] | select(.key as $k | ($mj.modules | map(.name) | index($k)) == null) ]
      | ( [ .[] | select(.value | contains($key)) | .key + ".md" ] | select(length > 0) | "FAIL generated rules for modules that no longer exist: \(join(", ")) — run orch architecture --sync" ),
        ( [ .[] | select(.value | contains($key) | not) | .key + ".md" ] | select(length > 0) | "FAIL hand-written files in .claude/rules/architecture/, which --sync owns: \(join(", ")) — move them to .claude/rules/" ) )')
  if [ -n "$out" ]; then printf '%s\n' "$out"; problems=$((problems + $(printf '%s\n' "$out" | grep -c '^FAIL'))); fi
  if [ "$problems" -gt 0 ]; then echo "map check: $problems problem(s)"; return 1; fi
  echo "map check: passed — $(jq '.modules | length' "$m/modules.json") modules cover the tree at $(git -C "$r" rev-parse --short "$sha"), rules in sync"
}

# arch_sync: .claude/rules/architecture/<module>.md from modules.json, and away with the ones it generated for modules now gone.
arch_sync() {
  local r m dir out name n=0 f; r=$(arch_root); m="$r/docs/architecture/modules.json"; dir="$r/.claude/rules/architecture"
  [ -f "$m" ] || die "no docs/architecture/modules.json in $r"
  out=$(arch_schema "$m"); [ -z "$out" ] || die "$out"
  mkdir -p "$dir"
  for name in $(jq -r '.modules[].name' "$m"); do
    jq -r --arg n "$name" --arg marker "$ARCH_MARKER" "$JQ_RULE"'.modules[] | select(.name == $n) | rule_text($marker)' "$m" > "$dir/$name.md"
    n=$((n + 1))
  done
  for f in "$dir"/*.md; do
    [ -f "$f" ] || continue
    jq -e --arg n "$(basename "$f" .md)" '.modules | map(.name) | index($n) != null' "$m" >/dev/null && continue
    grep -qF -- "$ARCH_MARK_KEY" "$f" && rm -f "$f" && echo "removed $(basename "$f"): its module is gone"
  done
  echo "synced $n rule file(s) into .claude/rules/architecture/ — commit them with the map"
}

# graph_tools <repo root>: the dependency-graph generators this stack could use, found or not.
graph_tools() {
  local r="$1"
  row() { printf '  %-8s %-30s %s\n' "$1" "$2" "$3"; }
  row any "git history (co-change)" available
  if [ -f "$r/package.json" ]; then
    # A one-shot npx run lands in the npx cache and changes nothing in the repository: no install-tools needed.
    if [ -x "$r/node_modules/.bin/depcruise" ]; then row js/ts dependency-cruiser available; else row js/ts dependency-cruiser "run once: npx --yes dependency-cruiser — no install needed, the repository is untouched"; fi
    if [ -x "$r/node_modules/.bin/madge" ]; then row js/ts madge available; else row js/ts madge "run once: npx --yes madge — no install needed"; fi
  fi
  if [ -f "$r/Cargo.toml" ]; then
    if command -v cargo >/dev/null 2>&1; then row rust "cargo metadata (crate graph)" available; fi
    if command -v cargo-modules >/dev/null 2>&1; then row rust cargo-modules available; else row rust cargo-modules "missing — cargo install --locked cargo-modules"; fi
  fi
  if [ -f "$r/pyproject.toml" ] || [ -f "$r/setup.py" ]; then
    if command -v pydeps >/dev/null 2>&1; then row python pydeps available; else row python pydeps "missing — pipx install pydeps"; fi
  fi
  if [ -f "$r/go.mod" ] && command -v go >/dev/null 2>&1; then row go "go mod graph" available; fi
  if [ -f "$r/pom.xml" ] || [ -f "$r/build.gradle" ] || [ -f "$r/build.gradle.kts" ]; then
    if command -v jdeps >/dev/null 2>&1; then row java jdeps available; else row java jdeps "missing — part of the JDK"; fi
  fi
}

cmd_architecture() {
  case "${1:-}" in
    --check) arch_check; return ;;
    --sync) arch_sync; return ;;
    '') ;;
    *) die "architecture [--check|--sync]" ;;
  esac
  local r files sha changed=0; r=$(arch_root)
  echo "architecture map: $(arch_status)"
  [ -f "$r/docs/architecture/modules.json" ] && echo "modules.json: $(jq '.modules | length' "$r/docs/architecture/modules.json" 2>/dev/null || echo 'unreadable') modules — orch architecture --check compares them with this tree"
  files=$(git -C "$r" ls-files | wc -l | tr -d ' ')
  echo "tracked files: $files"
  echo "by extension (5 files or more):"
  git -C "$r" ls-files | sed -n 's/.*\.\([A-Za-z0-9]*\)$/\1/p' | sort | uniq -c | sort -rn | awk '$1 >= 5 {printf "  %-10s %s\n", $2, $1}'
  sha=$(arch_sha)
  if [ -n "$sha" ]; then
    changed=$(git -C "$r" diff --name-only "$sha" HEAD | wc -l | tr -d ' ')
    echo "files changed since the map: $changed"
  fi
  echo "graph tools for this stack:"
  graph_tools "$r"
  echo "architect budget, a heuristic to calibrate after a run: building from scratch ~$((40 + files / 20)) calls, updating ~$((15 + changed / 5)) calls"
}

# cmd_close: nothing here deletes a branch or a worktree. It proves which of the run's branches are
# contained in the base branch (counting what it checked), drops the run's entries from the session
# index and marks the run closed.
cmd_close() {
  local d; d=$(run_dir "${1:-}"); local force=0
  [ "${2:-}" = --force ] && force=1
  # A reviewer or qa task is settled with the task it covers: the lead accepts the code and
  # reads the review as its evidence.
  local open; open=$(open_tasks "$d") || die "could not work out which tasks are accepted; refusing to close"
  open=$(printf '%s' "$open" | tr '\n' ' ')
  if [ -n "$open" ] && [ "$force" -eq 0 ]; then
    die "tasks not accepted: ${open}- accept them, or close anyway with: orch close ${1:-} --force"
  fi
  local root base h branch src n=0 loose=0 gone=0
  root=$(repo_root); base=$(jq -r '.baseBranch' "$d/plan.json")
  # The branches orch made for sessions, forgotten ones included, those handoffs name and the lead's own, each with where it came from.
  while IFS="$(printf '\t')" read -r branch src; do
    [ -n "$branch" ] && [ "$branch" != "$base" ] || continue
    git -C "$root" rev-parse -q --verify "refs/heads/$branch" >/dev/null 2>&1 || { gone=$((gone+1)); echo "already deleted: $branch ($src)"; continue; }
    n=$((n+1))
    if git -C "$root" merge-base --is-ancestor "$branch" "$base" 2>/dev/null; then
      echo "contained in $base: $branch ($src)"
    else
      loose=$((loose+1)); echo "NOT contained in $base: $branch ($src)"
    fi
  done < <( { cat "$d/sessions.json" "$d/forgotten.json" 2>/dev/null | jq -s -r 'add | .[] | .worktree // "" | select(. != "") | split("/") | last | . + "\tsession"'
              for h in "$d"/handoffs/*.md; do
                [ -f "$h" ] || continue
                branch=$(awk '/^## Branch/ {f=1; next} f && NF {print $1; exit}' "$h" | tr -d '`,')
                [ -z "$branch" ] || printf '%s\thandoff\n' "$branch"
              done
              [ ! -f "$d/lead-branches" ] || awk '{print $0 "\tlead"}' "$d/lead-branches"; } \
            | awk -F'\t' '!($1 in s) {o[++k] = $1; s[$1] = ""} index(", " s[$1] ", ", ", " $2 ", ") == 0 {s[$1] = s[$1] (s[$1] == "" ? "" : ", ") $2} END {for (i = 1; i <= k; i++) print o[i] "\t" s[o[i]]}')
  echo "$n refs checked, $loose not contained in $base, $gone already deleted$([ "$n" -eq 0 ] && printf ' — zero refs checked proves nothing about any branch; close before the cleanup to get this report')"
  local f dropped=0 real; real=$(cd "$d" && pwd -P)
  for f in "$INDEX_DIR"/*; do
    [ -f "$f" ] || continue
    case "$(cat "$f")" in "$d"|"$real") rm -f "$f"; dropped=$((dropped+1)) ;; esac
  done
  echo "session index: $dropped entries of this run removed"
  # The run is over: no session it spawned may outlive it, forgotten ones included. Worktrees and
  # branches stay for the cleanup.
  need claude
  # shellcheck disable=SC2046  # one session name per word
  remove_sessions "$d" "$d/sessions.json" $(jq -r '.[].name' "$d/sessions.json") || true
  # shellcheck disable=SC2046
  [ ! -f "$d/forgotten.json" ] || remove_sessions "$d" "$d/forgotten.json" $(jq -r '.[].name' "$d/forgotten.json") || true
  local listed; listed=$(listed_sessions "$d") || listed="(claude agents --json could not be read: nothing is verified)"
  cmd_status "$1" --no-live --no-ready
  if [ -n "$listed" ]; then
    printf 'orch: the run is not closed — these of its sessions are still listed in claude agents:\n%s\nremove each (orch rm %s <name>, or claude rm <id> after its worktree is settled), then run orch close again\n' "$listed" "${1:-}" >&2
    exit 1
  fi
  echo "no session of run ${1:-} is left in claude agents"
  local t forced=""
  for t in $open; do
    jq --arg id "$t" --arg t "$(now)" 'map(select(.taskId != $id)) + [{taskId:$id, at:$t, note:"open when the run was closed with --force"}]' "$d/cancelled.json" > "$d/cancelled.tmp" && mv "$d/cancelled.tmp" "$d/cancelled.json"
    forced="$forced $t"
  done
  [ -z "$forced" ] || echo "recorded as cancelled, open at close --force:$forced"
  now > "$d/CLOSED"
  ev "$d" orchestrator "${1:-}" close allow "$n refs checked, $loose not contained${forced:+; forced:$forced}"
}

cmd="${1:-}"; shift || true
# doctor is the one that reports a missing jq, and help needs none.
case "$cmd" in doctor|""|-h|--help|help) ;; *) need jq " (brew install jq / apt install jq)" ;; esac
case "$cmd" in
  doctor) cmd_doctor "$@" ;;
  start) cmd_start "$@" ;;
  init) cmd_init "$@" ;;
  plan) cmd_plan "$@" ;;
  ready) cmd_ready "$@" ;;
  brief) cmd_brief "$@" ;;
  spawn) cmd_spawn "$@" ;;
  continue) cmd_continue "$@" ;;
  status) cmd_status "$@" ;;
  events) cmd_events "$@" ;;
  runs) cmd_runs "$@" ;;
  graph) cmd_graph "$@" ;;
  inbox) cmd_inbox "$@" ;;
  handoff) cmd_handoff "$@" ;;
  followups) cmd_followups "$@" ;;
  handoff-put) cmd_handoff_put "$@" ;;
  qa-request) cmd_qa_request "$@" ;;
  accept) cmd_accept "$@" ;;
  address) cmd_address "$@" ;;
  authorize) cmd_authorize "$@" ;;
  review) cmd_review "$@" ;;
  interactive) cmd_interactive "$@" ;;
  tools) cmd_tools "$@" ;;
  budget) cmd_budget "$@" ;;
  task) cmd_task "$@" ;;
  paths) cmd_paths "$@" ;;
  cancel) cmd_cancel "$@" ;;
  stop) cmd_stop "$@" ;;
  forget) cmd_forget "$@" ;;
  rm) cmd_rm "$@" ;;
  grant) cmd_paths "${1:-}" "${2:-}" add "${@:3}" ;;
  cost) cmd_cost "$@" ;;
  pause) cmd_pause "$@" ;;
  resume) cmd_resume "$@" ;;
  resume-brief) cmd_resume_brief "$@" ;;
  freeze) cmd_freeze "$@" ;;
  thaw) cmd_thaw "$@" ;;
  decide) cmd_decide "$@" ;;
  lead-branch) cmd_lead_branch "$@" ;;
  close) cmd_close "$@" ;;
  acceptance) cmd_acceptance "$@" ;;
  approve) cmd_approve "$@" ;;
  stage-report) cmd_stage_report "$@" ;;
  architecture) cmd_architecture "$@" ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command '$cmd'"; ;;
esac
